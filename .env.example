# Environment
NODE_ENV=development
# Change PORT if occupied (e.g., 3001, 3002)
PORT=3000

# MongoDB
# Local:  mongodb://localhost:27017/pio_naujan
# Atlas:  mongodb+srv://<username>:<password>@<cluster>.mongodb.net/pio_naujan?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/pio_naujan

# Session
SESSION_SECRET=replace-with-a-long-random-session-secret

# JWT
JWT_SECRET=replace-with-a-long-random-jwt-secret
JWT_REFRESH_SECRET=replace-with-a-different-random-jwt-secret
JWT_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=7d

# CORS (comma-separated allowed origins)
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# App
APP_NAME=Public Information Office Naujan
APP_URL=http://localhost:3000

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./public/uploads

# Email (SMTP) — required for OTP login verification and password reset emails
# Gmail example: use an App Password (https://myaccount.google.com/apppasswords)
# Leave EMAIL_HOST blank to disable email; OTP codes will print to the server console instead (development only)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-gmail-app-password
EMAIL_FROM="Public Information Office Naujan" <no-reply@naujan.gov.ph>
