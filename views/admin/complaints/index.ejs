<!-- Page Header -->
<div class="admin-page-header">
  <nav aria-label="breadcrumb">
    <ol class="breadcrumb mb-1">
      <li class="breadcrumb-item"><a href="/admin/dashboard">Dashboard</a></li>
      <li class="breadcrumb-item active">Complaints</li>
    </ol>
  </nav>
  <h1><i class="fas fa-exclamation-circle"></i>Complaints</h1>
</div>

<!-- Filters -->
<div class="card admin-filter-card">
  <div class="card-body">
    <form method="GET" class="row g-2 align-items-end">
      <div class="col-md-3">
        <label class="form-label">Status</label>
        <select name="status" class="form-select">
          <option value="">All Statuses</option>
          <% ['pending','received','under_investigation','in_progress','resolved','dismissed'].forEach(s => { %>
            <option value="<%= s %>" <%= query.status === s ? 'selected' : '' %>><%= s.replace(/_/g,' ') %></option>
          <% }) %>
        </select>
      </div>
      <div class="col-md-3">
        <label class="form-label">Priority</label>
        <select name="priority" class="form-select">
          <option value="">All Priorities</option>
          <% ['low','medium','high','urgent'].forEach(p => { %>
            <option value="<%= p %>" <%= query.priority === p ? 'selected' : '' %>><%= p %></option>
          <% }) %>
        </select>
      </div>
      <div class="col-md-4">
        <label class="form-label">Search</label>
        <div class="input-group">
          <span class="input-group-text" style="background:transparent;border-right:none;"><i class="fas fa-search" style="font-size:0.8rem;color:var(--text-muted);"></i></span>
          <input type="text" name="search" class="form-control" style="border-left:none;" placeholder="Tracking code or subject..." value="<%= query.search || '' %>">
        </div>
      </div>
      <div class="col-md-2">
        <button type="submit" class="btn btn-primary w-100" style="border-radius:10px;"><i class="fas fa-filter me-1"></i>Filter</button>
      </div>
    </form>
  </div>
</div>

<div class="card admin-card">
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table admin-table mb-0">
        <thead>
          <tr>
            <th>Tracking Code</th>
            <th>Subject</th>
            <th>Category</th>
            <th>Status</th>
            <th>Priority</th>
            <th>Date</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% if (complaints.length === 0) { %>
            <tr><td colspan="7" class="text-center py-4 text-muted">No complaints found</td></tr>
          <% } else { %>
            <% complaints.forEach(c => { %>
              <tr>
                <td><code><%= c.trackingCode %></code></td>
                <td><%= truncate(c.subject, 30) %></td>
                <td><span class="badge bg-secondary"><%= c.category.replace(/_/g,' ') %></span></td>
                <td><span class="badge bg-<%= statusBadgeClass(c.status) %>"><%= c.status.replace(/_/g,' ') %></span></td>
                <td><span class="badge bg-<%= c.priority === 'urgent' ? 'danger' : c.priority === 'high' ? 'warning' : c.priority === 'medium' ? 'info' : 'secondary' %>"><%= c.priority %></span></td>
                <td class="small"><%= formatDate(c.createdAt, 'short') %></td>
                <td>
                  <a href="/admin/complaints/<%= c._id %>" class="btn btn-sm btn-outline-primary" title="View"><i class="fas fa-eye"></i></a>
                  <a href="/admin/complaints/<%= c._id %>/report" target="_blank" class="btn btn-sm btn-outline-warning" title="Generate Report"><i class="fas fa-print"></i></a>
                </td>
              </tr>
            <% }) %>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<% if (totalPages > 1) { %>
  <% const qp = '&status=' + (query.status || '') + '&priority=' + (query.priority || ''); %>
  <nav class="mt-3">
    <ul class="pagination justify-content-center">
      <li class="page-item page-nav <%= currentPage <= 1 ? 'disabled' : '' %>"><a class="page-link" href="?page=<%= currentPage - 1 %><%= qp %>"><i class="fas fa-chevron-left"></i><span class="page-nav-text ms-1">Prev</span></a></li>
      <% const delta = 2; for (let i = 1; i <= totalPages; i++) { if (i === 1 || i === totalPages || (i >= currentPage - delta && i <= currentPage + delta)) { %>
        <li class="page-item page-num <%= i === currentPage ? 'active' : '' %> <%= (i === 1 || i === totalPages) ? 'page-edge' : '' %>"><a class="page-link" href="?page=<%= i %><%= qp %>"><%= i %></a></li>
      <% } else if (i === currentPage - delta - 1 || i === currentPage + delta + 1) { %>
        <li class="page-item disabled"><span class="page-link">&hellip;</span></li>
      <% } } %>
      <li class="page-item page-nav <%= currentPage >= totalPages ? 'disabled' : '' %>"><a class="page-link" href="?page=<%= currentPage + 1 %><%= qp %>"><span class="page-nav-text me-1">Next</span><i class="fas fa-chevron-right"></i></a></li>
    </ul>
  </nav>
<% } %>
