<!-- Page Header -->
<div class="admin-page-header d-flex justify-content-between align-items-center">
  <div>
    <nav aria-label="breadcrumb">
      <ol class="breadcrumb mb-1">
        <li class="breadcrumb-item"><a href="/admin/dashboard">Dashboard</a></li>
        <li class="breadcrumb-item active">DRRM Updates</li>
      </ol>
    </nav>
    <h1><i class="fas fa-exclamation-triangle"></i>DRRM / Disaster Updates</h1>
  </div>
  <a href="/admin/disaster/create" class="btn btn-primary" style="border-radius:10px;padding:0.5rem 1.25rem;"><i class="fas fa-plus me-1"></i>New Alert</a>
</div>

<div class="card admin-card">
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table admin-table mb-0">
        <thead>
          <tr>
            <th>Title</th>
            <th>Alert Level</th>
            <th>Type</th>
            <th>Active</th>
            <th>Published</th>
            <th>Date</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% if (updates.length === 0) { %>
            <tr><td colspan="7" class="text-center py-4 text-muted">No alerts found</td></tr>
          <% } else { %>
            <% updates.forEach(u => { %>
              <tr>
                <td><%= truncate(u.title, 40) %></td>
                <td><span class="badge bg-<%= alertLevelClass(u.alertLevel) %>"><%= u.alertLevel %></span></td>
                <td><span class="badge bg-secondary"><%= u.type.replace(/_/g,' ') %></span></td>
                <td>
                  <% if (u.isActive) { %>
                    <i class="fas fa-check text-success"></i>
                  <% } else { %>
                    <i class="fas fa-times text-danger"></i>
                  <% } %>
                </td>
                <td>
                  <form action="/admin/disaster/<%= u._id %>/toggle-publish?_method=PATCH" method="POST" class="d-inline">
                    <button type="submit" class="btn btn-sm <%= u.isPublished ? 'btn-success' : 'btn-warning' %>" title="<%= u.isPublished ? 'Unpublish' : 'Publish' %>">
                      <i class="fas fa-<%= u.isPublished ? 'eye' : 'eye-slash' %> me-1"></i><%= u.isPublished ? 'Published' : 'Draft' %>
                    </button>
                  </form>
                </td>
                <td class="small"><%= formatDate(u.createdAt, 'short') %></td>
                <td>
                  <a href="/admin/disaster/<%= u._id %>/edit" class="btn btn-sm btn-outline-primary me-1"><i class="fas fa-edit"></i></a>
                  <form action="/admin/disaster/<%= u._id %>?_method=DELETE" method="POST" class="d-inline" data-confirm="Delete?">
                    <button class="btn btn-sm btn-outline-danger"><i class="fas fa-trash"></i></button>
                  </form>
                </td>
              </tr>
            <% }) %>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<% if (totalPages > 1) { %>
  <nav class="mt-3">
    <ul class="pagination justify-content-center">
      <li class="page-item page-nav <%= currentPage <= 1 ? 'disabled' : '' %>"><a class="page-link" href="?page=<%= currentPage - 1 %>"><i class="fas fa-chevron-left"></i><span class="page-nav-text ms-1">Prev</span></a></li>
      <% const delta = 2; for (let i = 1; i <= totalPages; i++) { if (i === 1 || i === totalPages || (i >= currentPage - delta && i <= currentPage + delta)) { %>
        <li class="page-item page-num <%= i === currentPage ? 'active' : '' %> <%= (i === 1 || i === totalPages) ? 'page-edge' : '' %>"><a class="page-link" href="?page=<%= i %>"><%= i %></a></li>
      <% } else if (i === currentPage - delta - 1 || i === currentPage + delta + 1) { %>
        <li class="page-item disabled"><span class="page-link">&hellip;</span></li>
      <% } } %>
      <li class="page-item page-nav <%= currentPage >= totalPages ? 'disabled' : '' %>"><a class="page-link" href="?page=<%= currentPage + 1 %>"><span class="page-nav-text me-1">Next</span><i class="fas fa-chevron-right"></i></a></li>
    </ul>
  </nav>
<% } %>
