<!-- Page Header -->
<div class="admin-page-header d-flex justify-content-between align-items-center">
  <div>
    <nav aria-label="breadcrumb">
      <ol class="breadcrumb mb-1">
        <li class="breadcrumb-item"><a href="/admin/dashboard">Dashboard</a></li>
        <li class="breadcrumb-item active">Users</li>
      </ol>
    </nav>
    <h1><i class="fas fa-users-cog"></i>Users</h1>
  </div>
  <a href="/admin/users/create" class="btn btn-primary" style="border-radius:10px;padding:0.5rem 1.25rem;"><i class="fas fa-plus me-1"></i>New User</a>
</div>

<div class="card admin-card">
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table admin-table mb-0">
        <thead>
          <tr>
            <th>Name</th>
            <th>Email</th>
            <th>Role</th>
            <th>Department</th>
            <th>Status</th>
            <th>Last Login</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% if (users.length === 0) { %>
            <tr><td colspan="7" class="text-center py-4 text-muted">No users found</td></tr>
          <% } else { %>
            <% users.forEach(u => { %>
              <tr>
                <td><%= u.firstName %> <%= u.lastName %></td>
                <td><%= u.email %></td>
                <td><span class="badge bg-primary"><%= u.role ? u.role.name.replace(/_/g,' ') : '—' %></span></td>
                <td><%= u.department ? u.department.name : '—' %></td>
                <td><span class="badge bg-<%= u.isActive ? 'success' : 'danger' %>"><%= u.isActive ? 'Active' : 'Inactive' %></span></td>
                <td class="small"><%= u.lastLogin ? formatDate(u.lastLogin, 'short') : 'Never' %></td>
                <td>
                  <a href="/admin/users/<%= u._id %>/edit" class="btn btn-sm btn-outline-primary me-1"><i class="fas fa-edit"></i></a>
                  <% if (u._id.toString() !== user._id.toString()) { %>
                    <form action="/admin/users/<%= u._id %>?_method=DELETE" method="POST" class="d-inline" data-confirm="Delete this user?">
                      <button class="btn btn-sm btn-outline-danger"><i class="fas fa-trash"></i></button>
                    </form>
                  <% } %>
                </td>
              </tr>
            <% }) %>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<% if (totalPages > 1) { %>
  <nav class="mt-3">
    <ul class="pagination justify-content-center">
      <li class="page-item page-nav <%= currentPage <= 1 ? 'disabled' : '' %>"><a class="page-link" href="?page=<%= currentPage - 1 %>"><i class="fas fa-chevron-left"></i><span class="page-nav-text ms-1">Prev</span></a></li>
      <% const delta = 2; for (let i = 1; i <= totalPages; i++) { if (i === 1 || i === totalPages || (i >= currentPage - delta && i <= currentPage + delta)) { %>
        <li class="page-item page-num <%= i === currentPage ? 'active' : '' %> <%= (i === 1 || i === totalPages) ? 'page-edge' : '' %>"><a class="page-link" href="?page=<%= i %>"><%= i %></a></li>
      <% } else if (i === currentPage - delta - 1 || i === currentPage + delta + 1) { %>
        <li class="page-item disabled"><span class="page-link">&hellip;</span></li>
      <% } } %>
      <li class="page-item page-nav <%= currentPage >= totalPages ? 'disabled' : '' %>"><a class="page-link" href="?page=<%= currentPage + 1 %>"><span class="page-nav-text me-1">Next</span><i class="fas fa-chevron-right"></i></a></li>
    </ul>
  </nav>
<% } %>
