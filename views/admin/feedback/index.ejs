<!-- Page Header -->
<div class="admin-page-header">
  <nav aria-label="breadcrumb">
    <ol class="breadcrumb mb-1">
      <li class="breadcrumb-item"><a href="/admin/dashboard">Dashboard</a></li>
      <li class="breadcrumb-item active">Feedback</li>
    </ol>
  </nav>
  <h1><i class="fas fa-comments"></i>Citizen Feedback</h1>
</div>

<!-- Filters -->
<div class="card admin-filter-card">
  <div class="card-body">
    <form method="GET" class="row g-2 align-items-end">
      <div class="col-md-4">
        <label class="form-label">Status</label>
        <select name="status" class="form-select">
          <option value="">All Statuses</option>
          <% ['new','read','responded','archived'].forEach(s => { %>
            <option value="<%= s %>" <%= query.status === s ? 'selected' : '' %>><%= s.charAt(0).toUpperCase() + s.slice(1) %></option>
          <% }) %>
        </select>
      </div>
      <div class="col-md-4">
        <label class="form-label">Category</label>
        <select name="category" class="form-select">
          <option value="">All Categories</option>
          <% ['suggestion','compliment','inquiry','general'].forEach(c => { %>
            <option value="<%= c %>" <%= query.category === c ? 'selected' : '' %>><%= c %></option>
          <% }) %>
        </select>
      </div>
      <div class="col-md-4">
        <button type="submit" class="btn btn-primary" style="border-radius:10px;"><i class="fas fa-filter me-1"></i>Filter</button>
        <a href="/admin/feedback" class="btn btn-outline-secondary ms-2" style="border-radius:10px;"><i class="fas fa-times me-1"></i>Reset</a>
      </div>
    </form>
  </div>
</div>

<div class="card admin-card">
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table admin-table mb-0">
        <thead>
          <tr>
            <th>From</th>
            <th>Subject</th>
            <th>Category</th>
            <th>Status</th>
            <th>Date</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% if (feedbacks.length === 0) { %>
            <tr><td colspan="6" class="text-center py-4 text-muted">No feedback found</td></tr>
          <% } else { %>
            <% feedbacks.forEach(fb => { %>
              <tr class="<%= fb.status === 'new' ? 'table-light fw-bold' : '' %>">
                <td><%= fb.citizenName %></td>
                <td><%= truncate(fb.subject, 40) %></td>
                <td><span class="badge bg-secondary"><%= fb.category %></span></td>
                <td><span class="badge bg-<%= fb.status === 'new' ? 'danger' : fb.status === 'read' ? 'warning' : fb.status === 'responded' ? 'success' : 'secondary' %>"><%= fb.status %></span></td>
                <td class="small"><%= formatDate(fb.createdAt, 'short') %></td>
                <td>
                  <a href="/admin/feedback/<%= fb._id %>" class="btn btn-sm btn-outline-primary me-1"><i class="fas fa-eye"></i></a>
                  <form action="/admin/feedback/<%= fb._id %>?_method=DELETE" method="POST" class="d-inline" data-confirm="Delete?">
                    <button class="btn btn-sm btn-outline-danger"><i class="fas fa-trash"></i></button>
                  </form>
                </td>
              </tr>
            <% }) %>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<% if (totalPages > 1) { %>
  <% const qp = '&status=' + (query.status || ''); %>
  <nav class="mt-3">
    <ul class="pagination justify-content-center">
      <li class="page-item page-nav <%= currentPage <= 1 ? 'disabled' : '' %>"><a class="page-link" href="?page=<%= currentPage - 1 %><%= qp %>"><i class="fas fa-chevron-left"></i><span class="page-nav-text ms-1">Prev</span></a></li>
      <% const delta = 2; for (let i = 1; i <= totalPages; i++) { if (i === 1 || i === totalPages || (i >= currentPage - delta && i <= currentPage + delta)) { %>
        <li class="page-item page-num <%= i === currentPage ? 'active' : '' %> <%= (i === 1 || i === totalPages) ? 'page-edge' : '' %>"><a class="page-link" href="?page=<%= i %><%= qp %>"><%= i %></a></li>
      <% } else if (i === currentPage - delta - 1 || i === currentPage + delta + 1) { %>
        <li class="page-item disabled"><span class="page-link">&hellip;</span></li>
      <% } } %>
      <li class="page-item page-nav <%= currentPage >= totalPages ? 'disabled' : '' %>"><a class="page-link" href="?page=<%= currentPage + 1 %><%= qp %>"><span class="page-nav-text me-1">Next</span><i class="fas fa-chevron-right"></i></a></li>
    </ul>
  </nav>
<% } %>
