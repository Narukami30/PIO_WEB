<!-- Page Header -->
<div class="admin-page-header d-flex justify-content-between align-items-center">
  <div>
    <nav aria-label="breadcrumb">
      <ol class="breadcrumb mb-1">
        <li class="breadcrumb-item"><a href="/admin/dashboard">Dashboard</a></li>
        <li class="breadcrumb-item active">Documents</li>
      </ol>
    </nav>
    <h1><i class="fas fa-file-alt"></i>Documents</h1>
  </div>
  <a href="/admin/documents/create" class="btn btn-primary" style="border-radius:10px;padding:0.5rem 1.25rem;"><i class="fas fa-plus me-1"></i>Upload Document</a>
</div>

<!-- Filters -->
<div class="card admin-filter-card">
  <div class="card-body">
    <form method="GET" class="row g-2 align-items-end">
      <div class="col-md-4">
        <label class="form-label">Category</label>
        <select name="category" class="form-select">
          <option value="">All Categories</option>
           <% ['ordinance','resolution','executive_order','citizen_charter','forms','reports','permits','other'].forEach(cat => { %>
            <option value="<%= cat %>" <%= query.category === cat ? 'selected' : '' %>><%= cat.replace(/_/g, ' ') %></option>
          <% }) %>
        </select>
      </div>
      <div class="col-md-4">
        <label class="form-label">Search</label>
        <div class="input-group">
          <span class="input-group-text" style="background:transparent;border-right:none;"><i class="fas fa-search" style="font-size:0.8rem;color:var(--text-muted);"></i></span>
          <input type="text" name="search" class="form-control" style="border-left:none;" placeholder="Search documents..." value="<%= query.search || '' %>">
        </div>
      </div>
      <div class="col-md-4">
        <button type="submit" class="btn btn-primary" style="border-radius:10px;"><i class="fas fa-filter me-1"></i>Filter</button>
        <a href="/admin/documents" class="btn btn-outline-secondary ms-2" style="border-radius:10px;"><i class="fas fa-times me-1"></i>Reset</a>
      </div>
    </form>
  </div>
</div>

<div class="card admin-card">
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table admin-table mb-0">
        <thead>
          <tr>
            <th>Title</th>
            <th>Category</th>
            <th>File</th>
            <th>Size</th>
            <th>Downloads</th>
            <th>Status</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% if (documents.length === 0) { %>
            <tr><td colspan="7" class="text-center py-5 text-muted">
              <i class="fas fa-folder-open" style="font-size:2rem;opacity:0.3;"></i>
              <p class="mt-2 mb-0">No documents found</p>
            </td></tr>
          <% } else { %>
            <% documents.forEach(doc => { %>
              <tr>
                <td class="fw-semibold"><%= truncate(doc.title, 40) %></td>
                <td><span class="badge bg-secondary" style="border-radius:6px;"><%= doc.category.replace(/_/g,' ') %></span></td>
                <td class="small text-muted"><%= doc.originalName %></td>
                <td class="small text-muted"><%= formatFileSize(doc.fileSize) %></td>
                <td><span class="badge" style="background:rgba(255,255,255,0.08);color:var(--text-primary);border-radius:6px;"><i class="fas fa-download me-1" style="font-size:0.65rem;"></i><%= doc.downloads %></span></td>
                <td><span class="badge bg-<%= doc.isPublished ? 'success' : 'warning' %>" style="border-radius:6px;"><%= doc.isPublished ? 'Published' : 'Draft' %></span></td>
                <td>
                  <div class="d-flex gap-1">
                    <a href="/admin/documents/<%= doc._id %>/edit" class="btn btn-sm btn-outline-primary" style="border-radius:8px;" title="Edit"><i class="fas fa-edit"></i></a>
                    <form action="/admin/documents/<%= doc._id %>?_method=DELETE" method="POST" class="d-inline" data-confirm="Delete?">
                      <button class="btn btn-sm btn-outline-danger" style="border-radius:8px;" title="Delete"><i class="fas fa-trash"></i></button>
                    </form>
                  </div>
                </td>
              </tr>
            <% }) %>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<% if (totalPages > 1) { %>
  <% const qp = '&category=' + (query.category || ''); %>
  <nav class="mt-3">
    <ul class="pagination justify-content-center">
      <li class="page-item page-nav <%= currentPage <= 1 ? 'disabled' : '' %>"><a class="page-link" href="?page=<%= currentPage - 1 %><%= qp %>"><i class="fas fa-chevron-left"></i><span class="page-nav-text ms-1">Prev</span></a></li>
      <% const delta = 2; for (let i = 1; i <= totalPages; i++) { if (i === 1 || i === totalPages || (i >= currentPage - delta && i <= currentPage + delta)) { %>
        <li class="page-item page-num <%= i === currentPage ? 'active' : '' %> <%= (i === 1 || i === totalPages) ? 'page-edge' : '' %>"><a class="page-link" href="?page=<%= i %><%= qp %>"><%= i %></a></li>
      <% } else if (i === currentPage - delta - 1 || i === currentPage + delta + 1) { %>
        <li class="page-item disabled"><span class="page-link">&hellip;</span></li>
      <% } } %>
      <li class="page-item page-nav <%= currentPage >= totalPages ? 'disabled' : '' %>"><a class="page-link" href="?page=<%= currentPage + 1 %><%= qp %>"><span class="page-nav-text me-1">Next</span><i class="fas fa-chevron-right"></i></a></li>
    </ul>
  </nav>
<% } %>
