<!-- Page Header -->
<div class="admin-page-header">
  <nav aria-label="breadcrumb">
    <ol class="breadcrumb mb-1">
      <li class="breadcrumb-item"><a href="/admin/dashboard">Dashboard</a></li>
      <li class="breadcrumb-item"><a href="/admin/departments">Departments</a></li>
      <li class="breadcrumb-item active"><%= isEdit ? 'Edit' : 'Create' %></li>
    </ol>
  </nav>
  <h1><i class="fas fa-building"></i><%= isEdit ? 'Edit' : 'New' %> Department</h1>
</div>

<div class="card admin-card">
  <div class="card-body p-4">
    <form action="<%= isEdit ? '/admin/departments/' + department._id + '?_method=PUT' : '/admin/departments' %>" method="POST" enctype="multipart/form-data">
      <div class="row g-3">
        <div class="col-md-6">
          <label class="form-label">Department Name *</label>
          <input type="text" name="name" class="form-control" required value="<%= isEdit ? department.name : '' %>">
        </div>
        <div class="col-md-3">
          <label class="form-label">Code *</label>
          <input type="text" name="code" class="form-control text-uppercase" required placeholder="e.g. MHO" value="<%= isEdit ? department.code : '' %>">
        </div>
        <div class="col-md-3">
          <label class="form-label">Order</label>
          <input type="number" name="order" class="form-control" value="<%= isEdit ? department.order : 0 %>">
        </div>
        <div class="col-12">
          <label class="form-label">Description</label>
          <textarea name="description" class="form-control" rows="3"><%= isEdit ? (department.description || '') : '' %></textarea>
        </div>
        <div class="col-md-4">
          <label class="form-label">Department Head</label>
          <input type="text" name="head" class="form-control" value="<%= isEdit ? (department.head || '') : '' %>">
        </div>
        <div class="col-md-4">
          <label class="form-label">Head Title</label>
          <input type="text" name="headTitle" class="form-control" placeholder="e.g. Municipal Health Officer" value="<%= isEdit ? (department.headTitle || '') : '' %>">
        </div>
        <div class="col-md-4">
          <label class="form-label">Location</label>
          <input type="text" name="location" class="form-control" value="<%= isEdit ? (department.location || '') : '' %>">
        </div>
        <div class="col-md-4">
          <label class="form-label">Email</label>
          <input type="email" name="email" class="form-control" value="<%= isEdit ? (department.email || '') : '' %>">
        </div>
        <div class="col-md-4">
          <label class="form-label">Phone</label>
          <input type="text" name="phone" class="form-control" value="<%= isEdit ? (department.phone || '') : '' %>">
        </div>
        <div class="col-md-4">
          <label class="form-label">Image</label>
          <input type="file" name="image" class="form-control" accept="image/*">
          <% if (isEdit && department.image) { %>
            <small class="text-muted">Current: <%= department.image %></small>
          <% } %>
        </div>
        <div class="col-md-4 d-flex align-items-end">
          <div class="form-check">
            <input type="checkbox" name="isActive" class="form-check-input" id="isActive" <%= (!isEdit || department.isActive) ? 'checked' : '' %>>
            <label class="form-check-label" for="isActive">Active</label>
          </div>
        </div>
      </div>
      <div class="mt-4 pt-3" style="border-top:1px solid rgba(255,255,255,0.08);">
        <button type="submit" class="btn btn-primary" style="border-radius:10px;padding:0.5rem 1.5rem;"><i class="fas fa-save me-1"></i>Save Department</button>
        <a href="/admin/departments" class="btn btn-outline-secondary ms-2" style="border-radius:10px;padding:0.5rem 1.5rem;"><i class="fas fa-times me-1"></i>Cancel</a>
      </div>
    </form>
  </div>
</div>
