<!-- Page Header -->
<div class="admin-page-header">
  <nav aria-label="breadcrumb">
    <ol class="breadcrumb mb-1">
      <li class="breadcrumb-item"><a href="/admin/dashboard">Dashboard</a></li>
      <li class="breadcrumb-item"><a href="/admin/transparency">Transparency</a></li>
      <li class="breadcrumb-item active"><%= isEdit ? 'Edit' : 'Create' %></li>
    </ol>
  </nav>
  <h1><i class="fas fa-landmark"></i><%= isEdit ? 'Edit' : 'New' %> Transparency Report</h1>
</div>

<div class="card admin-card">
  <div class="card-body p-4">
    <form action="<%= isEdit ? '/admin/transparency/' + report._id + '?_method=PUT' : '/admin/transparency' %>" method="POST" enctype="multipart/form-data">
      <div class="row g-3">
        <div class="col-md-8">
          <label class="form-label">Title *</label>
          <input type="text" name="title" class="form-control" required value="<%= isEdit ? report.title : '' %>">
        </div>
        <div class="col-md-4">
          <label class="form-label">Report Type *</label>
          <select name="reportType" class="form-select" required>
            <% ['transparency_seal','full_disclosure','annual_budget','annual_procurement','bid_results','financial_report','aip','quarterly_report','coa_report','other'].forEach(t => { %>
              <option value="<%= t %>" <%= (isEdit && report.reportType === t) ? 'selected' : '' %>><%= t.replace(/_/g, ' ') %></option>
            <% }) %>
          </select>
        </div>
        <div class="col-md-4">
          <label class="form-label">Fiscal Year *</label>
          <input type="number" name="fiscalYear" class="form-control" required value="<%= isEdit ? report.fiscalYear : new Date().getFullYear() %>">
        </div>
        <div class="col-md-4">
          <label class="form-label">Quarter</label>
          <select name="quarter" class="form-select">
            <option value="">N/A</option>
            <% ['Q1','Q2','Q3','Q4','annual'].forEach(q => { %>
              <option value="<%= q %>" <%= (isEdit && report.quarter === q) ? 'selected' : '' %>><%= q.toUpperCase() %></option>
            <% }) %>
          </select>
        </div>
        <div class="col-md-4">
          <label class="form-label">File <%= !isEdit ? '*' : '' %></label>
          <input type="file" name="file" class="form-control" <%= !isEdit ? 'required' : '' %>>
          <% if (isEdit && report.originalName) { %>
            <small class="text-muted">Current: <%= report.originalName %></small>
          <% } %>
        </div>
        <div class="col-md-4 d-flex align-items-end">
          <div class="form-check">
            <input type="checkbox" name="isPublished" class="form-check-input" id="isPublished" <%= (isEdit && report.isPublished) ? 'checked' : '' %>>
            <label class="form-check-label" for="isPublished">Published</label>
          </div>
        </div>
      </div>
      <div class="mt-4 pt-3" style="border-top:1px solid rgba(255,255,255,0.08);">
        <button type="submit" class="btn btn-primary" style="border-radius:10px;padding:0.5rem 1.5rem;"><i class="fas fa-save me-1"></i>Save Report</button>
        <a href="/admin/transparency" class="btn btn-outline-secondary ms-2" style="border-radius:10px;padding:0.5rem 1.5rem;"><i class="fas fa-times me-1"></i>Cancel</a>
      </div>
    </form>
  </div>
</div>
