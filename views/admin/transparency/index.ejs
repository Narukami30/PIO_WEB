<!-- Page Header -->
<div class="admin-page-header d-flex justify-content-between align-items-center">
  <div>
    <nav aria-label="breadcrumb">
      <ol class="breadcrumb mb-1">
        <li class="breadcrumb-item"><a href="/admin/dashboard">Dashboard</a></li>
        <li class="breadcrumb-item active">Transparency</li>
      </ol>
    </nav>
    <h1><i class="fas fa-landmark"></i>Transparency Reports</h1>
  </div>
  <a href="/admin/transparency/create" class="btn btn-primary" style="border-radius:10px;padding:0.5rem 1.25rem;"><i class="fas fa-plus me-1"></i>New Report</a>
</div>

<!-- Filters -->
<div class="card admin-filter-card">
  <div class="card-body">
    <form method="GET" class="row g-2 align-items-end">
      <div class="col-md-4">
        <label class="form-label">Type</label>
        <select name="type" class="form-select">
          <option value="">All Types</option>
          <% ['transparency_seal','full_disclosure','annual_budget','quarterly_budget','annual_procurement','bid_results','annual_report','audit_report','special_report','other'].forEach(t => { %>
            <option value="<%= t %>" <%= query.type === t ? 'selected' : '' %>><%= t.replace(/_/g, ' ') %></option>
          <% }) %>
        </select>
      </div>
      <div class="col-md-3">
        <label class="form-label">Year</label>
        <div class="input-group">
          <span class="input-group-text" style="background:transparent;border-right:none;"><i class="fas fa-calendar" style="font-size:0.8rem;color:var(--text-muted);"></i></span>
          <input type="number" name="year" class="form-control" style="border-left:none;" placeholder="e.g. 2024" value="<%= query.year || '' %>">
        </div>
      </div>
      <div class="col-md-5">
        <button type="submit" class="btn btn-primary" style="border-radius:10px;"><i class="fas fa-filter me-1"></i>Filter</button>
        <a href="/admin/transparency" class="btn btn-outline-secondary ms-2" style="border-radius:10px;"><i class="fas fa-times me-1"></i>Reset</a>
      </div>
    </form>
  </div>
</div>

<div class="card admin-card">
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table admin-table mb-0">
        <thead>
          <tr>
            <th>Title</th>
            <th>Type</th>
            <th>Year</th>
            <th>Quarter</th>
            <th>File</th>
            <th>Status</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% if (reports.length === 0) { %>
            <tr><td colspan="7" class="text-center py-5 text-muted">
              <i class="fas fa-landmark" style="font-size:2rem;opacity:0.3;"></i>
              <p class="mt-2 mb-0">No reports found</p>
            </td></tr>
          <% } else { %>
            <% reports.forEach(r => { %>
              <tr>
                <td class="fw-semibold"><%= truncate(r.title, 40) %></td>
                <td><span class="badge bg-secondary" style="border-radius:6px;"><%= r.reportType.replace(/_/g,' ') %></span></td>
                <td><%= r.fiscalYear %></td>
                <td><%= r.quarter || '—' %></td>
                <td class="small text-muted"><%= r.originalName %></td>
                <td><span class="badge bg-<%= r.isPublished ? 'success' : 'warning' %>" style="border-radius:6px;"><%= r.isPublished ? 'Published' : 'Draft' %></span></td>
                <td>
                  <div class="d-flex gap-1">
                    <a href="/admin/transparency/<%= r._id %>/edit" class="btn btn-sm btn-outline-primary" style="border-radius:8px;" title="Edit"><i class="fas fa-edit"></i></a>
                    <form action="/admin/transparency/<%= r._id %>?_method=DELETE" method="POST" class="d-inline" data-confirm="Delete?">
                      <button class="btn btn-sm btn-outline-danger" style="border-radius:8px;" title="Delete"><i class="fas fa-trash"></i></button>
                    </form>
                  </div>
                </td>
              </tr>
            <% }) %>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<% if (totalPages > 1) { %>
  <% const qp = '&type=' + (query.type || '') + '&year=' + (query.year || ''); %>
  <nav class="mt-3">
    <ul class="pagination justify-content-center">
      <li class="page-item page-nav <%= currentPage <= 1 ? 'disabled' : '' %>"><a class="page-link" href="?page=<%= currentPage - 1 %><%= qp %>"><i class="fas fa-chevron-left"></i><span class="page-nav-text ms-1">Prev</span></a></li>
      <% const delta = 2; for (let i = 1; i <= totalPages; i++) { if (i === 1 || i === totalPages || (i >= currentPage - delta && i <= currentPage + delta)) { %>
        <li class="page-item page-num <%= i === currentPage ? 'active' : '' %> <%= (i === 1 || i === totalPages) ? 'page-edge' : '' %>"><a class="page-link" href="?page=<%= i %><%= qp %>"><%= i %></a></li>
      <% } else if (i === currentPage - delta - 1 || i === currentPage + delta + 1) { %>
        <li class="page-item disabled"><span class="page-link">&hellip;</span></li>
      <% } } %>
      <li class="page-item page-nav <%= currentPage >= totalPages ? 'disabled' : '' %>"><a class="page-link" href="?page=<%= currentPage + 1 %><%= qp %>"><span class="page-nav-text me-1">Next</span><i class="fas fa-chevron-right"></i></a></li>
    </ul>
  </nav>
<% } %>
