<!-- Page Header -->
<div class="admin-page-header">
  <nav aria-label="breadcrumb">
    <ol class="breadcrumb mb-1">
      <li class="breadcrumb-item"><a href="/admin/dashboard">Dashboard</a></li>
      <li class="breadcrumb-item"><a href="/admin/announcements">Announcements</a></li>
      <li class="breadcrumb-item active"><%= isEdit ? 'Edit' : 'Create' %></li>
    </ol>
  </nav>
  <h1><i class="fas fa-bullhorn"></i><%= isEdit ? 'Edit' : 'New' %> Announcement</h1>
</div>

<div class="card admin-card">
  <div class="card-body p-4">
    <form action="<%= isEdit ? '/admin/announcements/' + announcement._id + '?_method=PUT' : '/admin/announcements' %>" method="POST" enctype="multipart/form-data">
      <div class="row g-3">
        <div class="col-md-8">
          <label class="form-label">Title *</label>
          <input type="text" name="title" class="form-control" required value="<%= isEdit ? announcement.title : '' %>">
        </div>
        <div class="col-md-4">
          <label class="form-label">Category *</label>
          <select name="category" class="form-select" required>
            <% ['general','notice','advisory','ordinance','resolution','executive_order','procurement','jobs','other'].forEach(cat => { %>
              <option value="<%= cat %>" <%= (isEdit && announcement.category === cat) ? 'selected' : '' %>><%= cat.replace(/_/g, ' ') %></option>
            <% }) %>
          </select>
        </div>
        <div class="col-12">
          <label class="form-label">Excerpt</label>
          <input type="text" name="excerpt" class="form-control" placeholder="Brief summary (optional)" value="<%= isEdit ? (announcement.excerpt || '') : '' %>">
        </div>
        <div class="col-12">
          <label class="form-label">Content *</label>
          <textarea name="content" class="form-control" rows="10" required><%= isEdit ? announcement.content : '' %></textarea>
        </div>
        <div class="col-md-6">
          <label class="form-label">Image</label>
          <input type="file" name="image" class="form-control" accept="image/*">
          <% if (isEdit && announcement.image) { %>
            <small class="text-muted">Current: <%= announcement.image %></small>
          <% } %>
        </div>
        <div class="col-md-3">
          <label class="form-label">Department</label>
          <select name="department" class="form-select">
            <option value="">None</option>
            <% if (typeof departments !== 'undefined') { %>
              <% departments.forEach(d => { %>
                <option value="<%= d._id %>" <%= (isEdit && announcement.department && announcement.department.toString() === d._id.toString()) ? 'selected' : '' %>><%= d.name %></option>
              <% }) %>
            <% } %>
          </select>
        </div>
        <div class="col-md-3 d-flex align-items-end gap-3">
          <div class="form-check">
            <input type="checkbox" name="isPublished" class="form-check-input" id="isPublished" <%= (isEdit && announcement.isPublished) ? 'checked' : '' %>>
            <label class="form-check-label" for="isPublished">Published</label>
          </div>
          <div class="form-check">
            <input type="checkbox" name="isPinned" class="form-check-input" id="isPinned" <%= (isEdit && announcement.isPinned) ? 'checked' : '' %>>
            <label class="form-check-label" for="isPinned">Pinned</label>
          </div>
        </div>
      </div>
      <div class="mt-4 pt-3" style="border-top:1px solid rgba(255,255,255,0.08);">
        <button type="submit" class="btn btn-primary" style="border-radius:10px;padding:0.5rem 1.5rem;"><i class="fas fa-save me-1"></i>Save Announcement</button>
        <a href="/admin/announcements" class="btn btn-outline-secondary ms-2" style="border-radius:10px;padding:0.5rem 1.5rem;"><i class="fas fa-times me-1"></i>Cancel</a>
      </div>
    </form>
  </div>
</div>
