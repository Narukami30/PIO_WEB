<!-- Welcome Banner -->
<div class="admin-welcome-banner">
  <div class="row align-items-center">
    <div class="col-md-8">
      <h2><i class="fas fa-hand-sparkles me-2" style="color:var(--naujan-gold);"></i>Welcome back<% if (user) { %>, <%= user.firstName %><% } %>!</h2>
      <p>Here's an overview of the Public Information Office Naujan portal. Manage content, respond to citizens, and keep Naujan informed.</p>
    </div>
    <div class="col-md-4 text-end d-none d-md-block">
      <div style="font-size:2.5rem;opacity:0.15;"><i class="fas fa-landmark"></i></div>
    </div>
  </div>
</div>

<!-- Primary Stats -->
<div class="row g-4 mb-4">
  <div class="col-xl-3 col-md-6">
    <div class="admin-stat-card stat-primary card">
      <div class="card-body p-3">
        <div class="d-flex justify-content-between align-items-start">
          <div>
            <div class="stat-label mb-2">Announcements</div>
            <div class="stat-value"><%= stats.announcements %></div>
          </div>
          <div class="stat-icon bg-primary-soft">
            <i class="fas fa-bullhorn"></i>
          </div>
        </div>
        <div class="mt-3 pt-2" style="border-top:1px solid rgba(255,255,255,0.06);">
          <a href="/admin/announcements" class="text-decoration-none" style="font-size:0.75rem;font-weight:600;color:var(--naujan-secondary);">
            Manage <i class="fas fa-arrow-right ms-1" style="font-size:0.65rem;"></i>
          </a>
        </div>
      </div>
    </div>
  </div>
  <div class="col-xl-3 col-md-6">
    <div class="admin-stat-card stat-success card">
      <div class="card-body p-3">
        <div class="d-flex justify-content-between align-items-start">
          <div>
            <div class="stat-label mb-2">Documents</div>
            <div class="stat-value"><%= stats.documents %></div>
          </div>
          <div class="stat-icon bg-success-soft">
            <i class="fas fa-file-alt"></i>
          </div>
        </div>
        <div class="mt-3 pt-2" style="border-top:1px solid rgba(255,255,255,0.06);">
          <a href="/admin/documents" class="text-decoration-none" style="font-size:0.75rem;font-weight:600;color:#198754;">
            Manage <i class="fas fa-arrow-right ms-1" style="font-size:0.65rem;"></i>
          </a>
        </div>
      </div>
    </div>
  </div>
  <div class="col-xl-3 col-md-6">
    <div class="admin-stat-card stat-warning card">
      <div class="card-body p-3">
        <div class="d-flex justify-content-between align-items-start">
          <div>
            <div class="stat-label mb-2">Pending Complaints</div>
            <div class="stat-value" style="color:#e67e00;"><%= stats.pendingComplaints %></div>
          </div>
          <div class="stat-icon bg-warning-soft">
            <i class="fas fa-exclamation-circle"></i>
          </div>
        </div>
        <div class="mt-3 pt-2" style="border-top:1px solid rgba(255,255,255,0.06);">
          <a href="/admin/complaints" class="text-decoration-none" style="font-size:0.75rem;font-weight:600;color:#e67e00;">
            Review <i class="fas fa-arrow-right ms-1" style="font-size:0.65rem;"></i>
          </a>
        </div>
      </div>
    </div>
  </div>
  <div class="col-xl-3 col-md-6">
    <div class="admin-stat-card stat-info card">
      <div class="card-body p-3">
        <div class="d-flex justify-content-between align-items-start">
          <div>
            <div class="stat-label mb-2">New Feedback</div>
            <div class="stat-value" style="color:#0dcaf0;"><%= stats.newFeedback %></div>
          </div>
          <div class="stat-icon bg-info-soft">
            <i class="fas fa-comments"></i>
          </div>
        </div>
        <div class="mt-3 pt-2" style="border-top:1px solid rgba(255,255,255,0.06);">
          <a href="/admin/feedback" class="text-decoration-none" style="font-size:0.75rem;font-weight:600;color:#0dcaf0;">
            View All <i class="fas fa-arrow-right ms-1" style="font-size:0.65rem;"></i>
          </a>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Secondary Stats + Quick Actions -->
<div class="row g-4 mb-4">
  <div class="col-lg-8">
    <div class="row g-3">
      <div class="col-md-3 col-6">
        <div class="card admin-stat-card border-0">
          <div class="card-body p-3 text-center">
            <div class="stat-icon bg-primary-soft mx-auto mb-2" style="width:42px;height:42px;border-radius:12px;font-size:0.95rem;">
              <i class="fas fa-calendar-alt"></i>
            </div>
            <div class="stat-value" style="font-size:1.35rem;"><%= stats.events %></div>
            <div class="stat-label" style="font-size:0.7rem;">Events</div>
          </div>
        </div>
      </div>
      <div class="col-md-3 col-6">
        <div class="card admin-stat-card border-0">
          <div class="card-body p-3 text-center">
            <div class="stat-icon bg-success-soft mx-auto mb-2" style="width:42px;height:42px;border-radius:12px;font-size:0.95rem;">
              <i class="fas fa-concierge-bell"></i>
            </div>
            <div class="stat-value" style="font-size:1.35rem;"><%= stats.services %></div>
            <div class="stat-label" style="font-size:0.7rem;">Services</div>
          </div>
        </div>
      </div>
      <div class="col-md-3 col-6">
        <div class="card admin-stat-card border-0">
          <div class="card-body p-3 text-center">
            <div class="stat-icon bg-info-soft mx-auto mb-2" style="width:42px;height:42px;border-radius:12px;font-size:0.95rem;">
              <i class="fas fa-building"></i>
            </div>
            <div class="stat-value" style="font-size:1.35rem;"><%= stats.departments %></div>
            <div class="stat-label" style="font-size:0.7rem;">Departments</div>
          </div>
        </div>
      </div>
      <div class="col-md-3 col-6">
        <div class="card admin-stat-card stat-danger border-0">
          <div class="card-body p-3 text-center">
            <div class="stat-icon bg-danger-soft mx-auto mb-2" style="width:42px;height:42px;border-radius:12px;font-size:0.95rem;">
              <i class="fas fa-shield-alt"></i>
            </div>
            <div class="stat-value" style="font-size:1.35rem;color:#dc3545;"><%= stats.activeAlerts %></div>
            <div class="stat-label" style="font-size:0.7rem;">Active Alerts</div>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="col-lg-4">
    <div class="card admin-card h-100">
      <div class="card-header">
        <h5 class="mb-0"><i class="fas fa-bolt me-2" style="color:var(--naujan-gold);"></i>Quick Actions</h5>
      </div>
      <div class="card-body d-flex flex-column gap-2 p-3">
        <a href="/admin/announcements/create" class="admin-quick-action">
          <div class="qa-icon" style="background:rgba(21,101,192,0.18);color:var(--naujan-primary);"><i class="fas fa-plus"></i></div>
          <div>
            <div class="qa-text">New Announcement</div>
            <div class="qa-desc">Publish news or advisory</div>
          </div>
        </a>
        <a href="/admin/disaster/create" class="admin-quick-action">
          <div class="qa-icon" style="background:rgba(220,53,69,0.18);color:#dc3545;"><i class="fas fa-exclamation-triangle"></i></div>
          <div>
            <div class="qa-text">New DRRM Alert</div>
            <div class="qa-desc">Publish disaster update</div>
          </div>
        </a>
        <a href="/admin/events/create" class="admin-quick-action">
          <div class="qa-icon" style="background:rgba(25,135,84,0.18);color:#198754;"><i class="fas fa-calendar-plus"></i></div>
          <div>
            <div class="qa-text">New Event</div>
            <div class="qa-desc">Schedule a community event</div>
          </div>
        </a>
      </div>
    </div>
  </div>
</div>

<!-- Recent Tables -->
<div class="row g-4">
  <!-- Recent Feedback -->
  <div class="col-lg-6">
    <div class="card admin-card">
      <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0"><i class="fas fa-comments me-2" style="color:#0dcaf0;"></i>Recent Feedback</h5>
        <a href="/admin/feedback" class="btn btn-sm" style="border-radius:8px;font-size:0.75rem;font-weight:600;background:var(--naujan-light);color:var(--naujan-primary);">View All</a>
      </div>
      <div class="card-body p-0">
        <div class="table-responsive">
          <table class="table admin-table mb-0">
            <thead>
              <tr><th>From</th><th>Subject</th><th>Status</th><th>Date</th></tr>
            </thead>
            <tbody>
              <% if (recentFeedback.length === 0) { %>
                <tr>
                  <td colspan="4" class="text-center py-4">
                    <i class="fas fa-inbox fa-2x mb-2" style="color:var(--border-color);"></i>
                    <p class="mb-0 text-muted" style="font-size:0.82rem;">No feedback yet</p>
                  </td>
                </tr>
              <% } else { %>
                <% recentFeedback.forEach(fb => { %>
                  <tr>
                    <td>
                      <div class="d-flex align-items-center gap-2">
                        <div style="width:28px;height:28px;border-radius:8px;background:rgba(66,165,245,0.18);display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                          <i class="fas fa-user" style="font-size:0.6rem;color:var(--naujan-secondary);"></i>
                        </div>
                        <span style="font-weight:600;font-size:0.82rem;"><%= fb.citizenName %></span>
                      </div>
                    </td>
                    <td style="font-size:0.82rem;"><%= truncate(fb.subject, 25) %></td>
                    <td><span class="badge bg-<%= fb.status === 'new' ? 'danger' : fb.status === 'read' ? 'warning' : 'success' %>"><%= fb.status %></span></td>
                    <td class="small" style="color:var(--text-muted);"><%= formatDate(fb.createdAt, 'short') %></td>
                  </tr>
                <% }) %>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>

  <!-- Recent Complaints -->
  <div class="col-lg-6">
    <div class="card admin-card">
      <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0"><i class="fas fa-exclamation-circle me-2" style="color:#e67e00;"></i>Recent Complaints</h5>
        <a href="/admin/complaints" class="btn btn-sm" style="border-radius:8px;font-size:0.75rem;font-weight:600;background:var(--naujan-light);color:var(--naujan-primary);">View All</a>
      </div>
      <div class="card-body p-0">
        <div class="table-responsive">
          <table class="table admin-table mb-0">
            <thead>
              <tr><th>Code</th><th>Subject</th><th>Status</th><th>Priority</th></tr>
            </thead>
            <tbody>
              <% if (recentComplaints.length === 0) { %>
                <tr>
                  <td colspan="4" class="text-center py-4">
                    <i class="fas fa-check-circle fa-2x mb-2" style="color:rgba(25,135,84,0.3);"></i>
                    <p class="mb-0 text-muted" style="font-size:0.82rem;">No complaints yet</p>
                  </td>
                </tr>
              <% } else { %>
                <% recentComplaints.forEach(c => { %>
                  <tr>
                    <td><code style="background:rgba(66,165,245,0.15);padding:0.2rem 0.5rem;border-radius:6px;font-size:0.78rem;font-weight:600;"><%= c.trackingCode %></code></td>
                    <td style="font-size:0.82rem;"><%= truncate(c.subject, 25) %></td>
                    <td><span class="badge bg-<%= statusBadgeClass(c.status) %>"><%= c.status.replace(/_/g,' ') %></span></td>
                    <td><span class="badge bg-<%= c.priority === 'urgent' ? 'danger' : c.priority === 'high' ? 'warning' : 'info' %>"><%= c.priority %></span></td>
                  </tr>
                <% }) %>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>
