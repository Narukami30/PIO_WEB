<!-- Page Header -->
<div class="admin-page-header">
  <nav aria-label="breadcrumb">
    <ol class="breadcrumb mb-1">
      <li class="breadcrumb-item"><a href="/admin/dashboard">Dashboard</a></li>
      <li class="breadcrumb-item"><a href="/admin/services">Services</a></li>
      <li class="breadcrumb-item active"><%= isEdit ? 'Edit' : 'Create' %></li>
    </ol>
  </nav>
  <h1><i class="fas fa-concierge-bell"></i><%= isEdit ? 'Edit' : 'New' %> Service</h1>
</div>

<div class="card admin-card">
  <div class="card-body p-4">
    <form action="<%= isEdit ? '/admin/services/' + service._id + '?_method=PUT' : '/admin/services' %>" method="POST">
      <div class="row g-3">
        <div class="col-md-8">
          <label class="form-label">Service Name *</label>
          <input type="text" name="name" class="form-control" required value="<%= isEdit ? service.name : '' %>">
        </div>
        <div class="col-md-4">
          <label class="form-label">Department</label>
          <select name="department" class="form-select">
            <option value="">None</option>
            <% if (typeof departments !== 'undefined') { %>
              <% departments.forEach(d => { %>
                <option value="<%= d._id %>" <%= (isEdit && service.department && service.department.toString() === d._id.toString()) ? 'selected' : '' %>><%= d.name %></option>
              <% }) %>
            <% } %>
          </select>
        </div>
        <div class="col-12">
          <label class="form-label">Description *</label>
          <textarea name="description" class="form-control" rows="4" required><%= isEdit ? service.description : '' %></textarea>
        </div>
        <div class="col-12">
          <label class="form-label">Requirements (one per line)</label>
          <textarea name="requirements" class="form-control" rows="4" placeholder="Requirement 1&#10;Requirement 2&#10;..."><%= (isEdit && service.requirements) ? service.requirements.join('\n') : '' %></textarea>
        </div>
        <div class="col-12">
          <label class="form-label">Steps (one per line, in order)</label>
          <textarea name="steps" class="form-control" rows="4" placeholder="Step 1 description&#10;Step 2 description&#10;..."><%= (isEdit && service.steps) ? service.steps.map(s => s.description).join('\n') : '' %></textarea>
        </div>
        <div class="col-md-4">
          <label class="form-label">Fees</label>
          <input type="text" name="fees" class="form-control" placeholder="e.g. PHP 100.00 or Free" value="<%= isEdit ? (service.fees || '') : '' %>">
        </div>
        <div class="col-md-4">
          <label class="form-label">Processing Time</label>
          <input type="text" name="processingTime" class="form-control" placeholder="e.g. 3-5 working days" value="<%= isEdit ? (service.processingTime || '') : '' %>">
        </div>
        <div class="col-md-2">
          <label class="form-label">Order</label>
          <input type="number" name="order" class="form-control" value="<%= isEdit ? service.order : 0 %>">
        </div>
        <div class="col-md-2 d-flex align-items-end">
          <div class="form-check">
            <input type="checkbox" name="isActive" class="form-check-input" id="isActive" <%= (!isEdit || service.isActive) ? 'checked' : '' %>>
            <label class="form-check-label" for="isActive">Active</label>
          </div>
        </div>
      </div>
      <div class="mt-4 pt-3" style="border-top:1px solid rgba(255,255,255,0.08);">
        <button type="submit" class="btn btn-primary" style="border-radius:10px;padding:0.5rem 1.5rem;"><i class="fas fa-save me-1"></i>Save Service</button>
        <a href="/admin/services" class="btn btn-outline-secondary ms-2" style="border-radius:10px;padding:0.5rem 1.5rem;"><i class="fas fa-times me-1"></i>Cancel</a>
      </div>
    </form>
  </div>
</div>
