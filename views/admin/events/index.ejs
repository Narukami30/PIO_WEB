<!-- Page Header -->
<div class="admin-page-header d-flex justify-content-between align-items-center">
  <div>
    <nav aria-label="breadcrumb">
      <ol class="breadcrumb mb-1">
        <li class="breadcrumb-item"><a href="/admin/dashboard">Dashboard</a></li>
        <li class="breadcrumb-item active">Events</li>
      </ol>
    </nav>
    <h1><i class="fas fa-calendar-alt"></i>Events</h1>
  </div>
  <a href="/admin/events/create" class="btn btn-primary" style="border-radius:10px;padding:0.5rem 1.25rem;"><i class="fas fa-plus me-1"></i>New Event</a>
</div>

<div class="card admin-card">
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table admin-table mb-0">
        <thead>
          <tr>
            <th>Title</th>
            <th>Category</th>
            <th>Date</th>
            <th>Location</th>
            <th>Status</th>
            <th>Featured</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% if (events.length === 0) { %>
            <tr><td colspan="7" class="text-center py-5 text-muted">
              <i class="fas fa-calendar-times" style="font-size:2rem;opacity:0.3;"></i>
              <p class="mt-2 mb-0">No events found</p>
            </td></tr>
          <% } else { %>
            <% events.forEach(e => { %>
              <tr>
                <td class="fw-semibold"><%= truncate(e.title, 40) %></td>
                <td><span class="badge bg-secondary" style="border-radius:6px;"><%= e.category.replace(/_/g,' ') %></span></td>
                <td class="small text-muted"><%= formatDate(e.startDate, 'short') %></td>
                <td class="small"><%= e.location || '—' %></td>
                <td><span class="badge bg-<%= e.isPublished ? 'success' : 'warning' %>" style="border-radius:6px;"><%= e.isPublished ? 'Published' : 'Draft' %></span></td>
                 <td>
                   <% if (e.isFeatured) { %>
                     <i class="fas fa-star text-warning"></i>
                   <% } else { %>
                     <i class="far fa-star text-muted" style="opacity:0.3;"></i>
                   <% } %>
                 </td>
                <td>
                  <div class="d-flex gap-1">
                    <a href="/admin/events/<%= e._id %>/edit" class="btn btn-sm btn-outline-primary" style="border-radius:8px;" title="Edit"><i class="fas fa-edit"></i></a>
                    <form action="/admin/events/<%= e._id %>?_method=DELETE" method="POST" class="d-inline" data-confirm="Delete this event?">
                      <button class="btn btn-sm btn-outline-danger" style="border-radius:8px;" title="Delete"><i class="fas fa-trash"></i></button>
                    </form>
                  </div>
                </td>
              </tr>
            <% }) %>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<% if (totalPages > 1) { %>
  <nav class="mt-3">
    <ul class="pagination justify-content-center">
      <li class="page-item page-nav <%= currentPage <= 1 ? 'disabled' : '' %>"><a class="page-link" href="?page=<%= currentPage - 1 %>"><i class="fas fa-chevron-left"></i><span class="page-nav-text ms-1">Prev</span></a></li>
      <% const delta = 2; for (let i = 1; i <= totalPages; i++) { if (i === 1 || i === totalPages || (i >= currentPage - delta && i <= currentPage + delta)) { %>
        <li class="page-item page-num <%= i === currentPage ? 'active' : '' %> <%= (i === 1 || i === totalPages) ? 'page-edge' : '' %>"><a class="page-link" href="?page=<%= i %>"><%= i %></a></li>
      <% } else if (i === currentPage - delta - 1 || i === currentPage + delta + 1) { %>
        <li class="page-item disabled"><span class="page-link">&hellip;</span></li>
      <% } } %>
      <li class="page-item page-nav <%= currentPage >= totalPages ? 'disabled' : '' %>"><a class="page-link" href="?page=<%= currentPage + 1 %>"><span class="page-nav-text me-1">Next</span><i class="fas fa-chevron-right"></i></a></li>
    </ul>
  </nav>
<% } %>
