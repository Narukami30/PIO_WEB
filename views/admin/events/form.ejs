<!-- Page Header -->
<div class="admin-page-header">
  <nav aria-label="breadcrumb">
    <ol class="breadcrumb mb-1">
      <li class="breadcrumb-item"><a href="/admin/dashboard">Dashboard</a></li>
      <li class="breadcrumb-item"><a href="/admin/events">Events</a></li>
      <li class="breadcrumb-item active"><%= isEdit ? 'Edit' : 'Create' %></li>
    </ol>
  </nav>
  <h1><i class="fas fa-calendar-alt"></i><%= isEdit ? 'Edit' : 'New' %> Event</h1>
</div>

<div class="card admin-card">
  <div class="card-body p-4">
    <form action="<%= isEdit ? '/admin/events/' + event._id + '?_method=PUT' : '/admin/events' %>" method="POST" enctype="multipart/form-data">
      <div class="row g-3">
        <div class="col-md-8">
          <label class="form-label">Title *</label>
          <input type="text" name="title" class="form-control" required value="<%= isEdit ? event.title : '' %>">
        </div>
        <div class="col-md-4">
          <label class="form-label">Category *</label>
          <select name="category" class="form-select" required>
            <% ['fiesta','meeting','seminar','sports','health','outreach','ceremony','other'].forEach(cat => { %>
              <option value="<%= cat %>" <%= (isEdit && event.category === cat) ? 'selected' : '' %>><%= cat.replace(/_/g, ' ') %></option>
            <% }) %>
          </select>
        </div>
        <div class="col-12">
          <label class="form-label">Description *</label>
          <textarea name="description" class="form-control" rows="6" required><%= isEdit ? event.description : '' %></textarea>
        </div>
        <div class="col-md-4">
          <label class="form-label">Start Date *</label>
          <input type="datetime-local" name="startDate" class="form-control" required value="<%= (isEdit && event.startDate) ? new Date(event.startDate).toISOString().slice(0,16) : '' %>">
        </div>
        <div class="col-md-4">
          <label class="form-label">End Date</label>
          <input type="datetime-local" name="endDate" class="form-control" value="<%= (isEdit && event.endDate) ? new Date(event.endDate).toISOString().slice(0,16) : '' %>">
        </div>
        <div class="col-md-4">
          <label class="form-label">Location</label>
          <input type="text" name="location" class="form-control" value="<%= isEdit ? (event.location || '') : '' %>">
        </div>
        <div class="col-md-4">
          <label class="form-label">Image</label>
          <input type="file" name="image" class="form-control" accept="image/*">
          <% if (isEdit && event.image) { %>
            <small class="text-muted">Current: <%= event.image %></small>
          <% } %>
        </div>
        <div class="col-md-4">
          <label class="form-label">Department</label>
          <select name="department" class="form-select">
            <option value="">None</option>
            <% if (typeof departments !== 'undefined') { %>
              <% departments.forEach(d => { %>
                <option value="<%= d._id %>" <%= (isEdit && event.department && event.department.toString() === d._id.toString()) ? 'selected' : '' %>><%= d.name %></option>
              <% }) %>
            <% } %>
          </select>
        </div>
        <div class="col-md-4 d-flex align-items-end gap-3">
          <div class="form-check">
            <input type="checkbox" name="isPublished" class="form-check-input" id="isPublished" <%= (isEdit && event.isPublished) ? 'checked' : '' %>>
            <label class="form-check-label" for="isPublished">Published</label>
          </div>
          <div class="form-check">
            <input type="checkbox" name="isFeatured" class="form-check-input" id="isFeatured" <%= (isEdit && event.isFeatured) ? 'checked' : '' %>>
            <label class="form-check-label" for="isFeatured">Featured</label>
          </div>
        </div>
      </div>
      <div class="mt-4 pt-3" style="border-top:1px solid rgba(255,255,255,0.08);">
        <button type="submit" class="btn btn-primary" style="border-radius:10px;padding:0.5rem 1.5rem;"><i class="fas fa-save me-1"></i>Save Event</button>
        <a href="/admin/events" class="btn btn-outline-secondary ms-2" style="border-radius:10px;padding:0.5rem 1.5rem;"><i class="fas fa-times me-1"></i>Cancel</a>
      </div>
    </form>
  </div>
</div>
