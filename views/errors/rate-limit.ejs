<section class="py-5">
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-lg-6 text-center fade-up">
        <div class="icon-wrapper mx-auto mb-4" style="width:100px;height:100px;font-size:2.5rem;background:rgba(220,53,69,0.15);color:#dc3545;">
          <i class="fas fa-hourglass-half"></i>
        </div>
        <h2 class="fw-bold mb-3">Too Many Requests</h2>
        <p class="text-muted mb-4">You've made too many requests in a short period. Please wait before trying again.</p>
        <div class="card border-0 shadow-sm rounded-4 p-4 mb-4" style="background:rgba(255,255,255,0.04);">
          <p class="mb-2" style="color:var(--text-muted);font-size:0.9rem;">You can try again in:</p>
          <h3 class="fw-bold mb-0" id="countdown" style="color:var(--naujan-secondary);font-size:2rem;font-variant-numeric:tabular-nums;">
            --:--
          </h3>
        </div>
        <a href="javascript:history.back()" class="btn btn-outline-primary rounded-3"><i class="fas fa-arrow-left me-2"></i>Go Back</a>
      </div>
    </div>
  </div>
</section>

<script nonce="<%= typeof cspNonce !== 'undefined' ? cspNonce : '' %>">
(function() {
  var seconds = parseInt('<%= typeof retryAfter !== "undefined" ? retryAfter : 900 %>', 10) || 900;
  var el = document.getElementById('countdown');
  function tick() {
    if (seconds <= 0) {
      el.textContent = 'Ready!';
      return;
    }
    var m = Math.floor(seconds / 60);
    var s = seconds % 60;
    el.textContent = (m < 10 ? '0' : '') + m + ':' + (s < 10 ? '0' : '') + s;
    seconds--;
    setTimeout(tick, 1000);
  }
  tick();
})();
</script>
