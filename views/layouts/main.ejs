<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <meta name="theme-color" content="#080f1e">
  <meta name="description" content="Public Information Office — Municipality of Naujan, Oriental Mindoro. Your gateway to transparent governance, community services, and real-time municipal updates.">
  <title><%= typeof title !== 'undefined' ? title + ' | ' : '' %><%= appName %></title>
  <!-- Favicon -->
  <link rel="icon" type="image/png" href="<%= typeof siteLogo !== 'undefined' && siteLogo ? siteLogo : '/uploads/images/pio-logo.png' %>">
  <!-- Open Graph / Social -->
  <meta property="og:type" content="website">
  <meta property="og:title" content="<%= typeof title !== 'undefined' ? title + ' | ' : '' %><%= appName %>">
  <meta property="og:description" content="Public Information Office — Municipality of Naujan, Oriental Mindoro. Your gateway to transparent governance, community services, and real-time municipal updates.">
  <meta property="og:image" content="<%= typeof siteLogo !== 'undefined' && siteLogo ? siteLogo : '/uploads/images/pio-logo.png' %>">
  <meta property="og:url" content="<%= (typeof appUrl !== 'undefined' ? appUrl : '') + (typeof currentPath !== 'undefined' ? currentPath : '/') %>">
  <meta property="og:site_name" content="<%= appName %>">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
  <link href="/css/style.css" rel="stylesheet">
</head>
<body>
  <!-- Skip to Content (a11y) -->
  <a href="#main-content" class="skip-to-content">Skip to main content</a>

  <!-- Notification Banner -->
  <%- include('../partials/notificationBanner') %>
  <!-- Page Loader -->
  <div class="page-loader">
    <div class="loader-spinner">
      <div></div><div></div><div></div>
    </div>
  </div>

  <!-- Scroll Progress Bar -->
  <div class="scroll-progress" style="position:fixed;top:0;left:0;height:3px;background:linear-gradient(90deg,var(--naujan-gold),var(--naujan-secondary));z-index:9999;width:0;transition:width 0.1s linear;"></div>

  <%- include('../partials/nav') %>

  <!-- Flash Messages -->
  <div class="container mt-3">
    <% if (typeof error_msg !== 'undefined' && error_msg.length > 0) { %>
      <div class="alert alert-danger alert-dismissible fade show" style="border-radius:var(--radius-md);border:none;box-shadow:var(--shadow-sm);">
        <i class="fas fa-exclamation-circle me-2"></i><%= error_msg %>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
    <% } %>
    <% if (typeof error !== 'undefined' && error.length > 0) { %>
      <div class="alert alert-danger alert-dismissible fade show" style="border-radius:var(--radius-md);border:none;box-shadow:var(--shadow-sm);">
        <i class="fas fa-exclamation-circle me-2"></i><%= error %>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
    <% } %>
  </div>

  <main id="main-content">
  <%- body %>
  </main>

  <%- include('../partials/footer') %>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/main.js"></script>

  <!-- Back to Top Button -->
  <button class="back-to-top" title="Back to top">
    <i class="fas fa-chevron-up"></i>
  </button>
</body>
</html>
