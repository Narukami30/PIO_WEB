<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title + ' | ' : '' %>Admin - <%= appName %></title>
  <link rel="icon" type="image/png" href="<%= typeof siteLogo !== 'undefined' && siteLogo ? siteLogo : '/uploads/images/pio-logo.png' %>">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
  <link href="/css/style.css" rel="stylesheet">
</head>
<body class="admin-body">
    <!-- Admin Notification Banner -->
    <%- include('../partials/adminNotificationBanner') %>
  <!-- Sidebar backdrop overlay for mobile -->
  <div class="sidebar-backdrop" id="sidebarBackdrop"></div>

  <div class="d-flex" id="adminWrapper">
    <%- include('../partials/adminSidebar') %>

    <div id="adminContent" class="admin-content flex-grow-1">
      <!-- Admin Top Bar -->
      <nav class="navbar navbar-expand-lg navbar-dark admin-topbar">
        <div class="container-fluid">
          <button class="btn btn-link" id="sidebarToggle">
            <i class="fas fa-bars"></i>
          </button>

          <div class="d-flex align-items-center ms-auto gap-3">
            <!-- Quick actions -->
            <div class="d-none d-md-flex align-items-center gap-2">
              <a href="/" target="_blank" class="btn btn-sm" style="background:rgba(255,255,255,0.06);border-radius:8px;font-size:0.78rem;color:var(--naujan-secondary);font-weight:600;padding:0.35rem 0.75rem;border:1px solid rgba(255,255,255,0.08);" data-bs-toggle="tooltip" title="View Website">
                <i class="fas fa-external-link-alt me-1"></i> Site
              </a>
            </div>

            <!-- Current datetime -->
            <span class="d-none d-lg-inline" style="font-size:0.75rem;color:var(--text-muted);font-weight:500;">
              <i class="far fa-clock me-1"></i>
              <script nonce="<%= cspNonce %>">document.write(new Date().toLocaleDateString('en-PH', {weekday:'short', month:'short', day:'numeric', year:'numeric'}))</script>
            </span>

            <!-- Divider -->
            <div class="d-none d-md-block" style="width:1px;height:28px;background:var(--border-color);"></div>

            <!-- User profile -->
            <div class="d-flex align-items-center gap-2">
              <div style="width:36px;height:36px;border-radius:10px;background:linear-gradient(135deg,var(--naujan-primary),var(--naujan-secondary));display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                <i class="fas fa-user text-white" style="font-size:0.7rem;"></i>
              </div>
              <div class="d-none d-md-block">
                <% if (user) { %><div style="font-size:0.82rem;font-weight:700;color:var(--text-primary);line-height:1.2;"><%= user.firstName %> <%= user.lastName %></div><% } %>
                <% if (user && user.role) { %><div style="font-size:0.65rem;color:var(--naujan-secondary);font-weight:600;text-transform:uppercase;letter-spacing:0.5px;"><%= user.role.displayName %></div><% } %>
              </div>
            </div>
            <form action="/auth/logout" method="POST" class="m-0">
              <button type="submit" class="btn btn-sm" style="border-radius:10px;padding:0.4rem 0.85rem;font-size:0.78rem;font-weight:600;background:rgba(220,53,69,0.15);color:#f87171;border:1px solid rgba(220,53,69,0.2);">
                <i class="fas fa-sign-out-alt me-1"></i> <span class="d-none d-md-inline">Logout</span>
              </button>
            </form>
          </div>
        </div>
      </nav>

      <!-- Flash Messages -->
      <div class="container-fluid mt-3 px-4">
        <% if (typeof error_msg !== 'undefined' && error_msg.length > 0) { %>
          <div class="alert alert-danger alert-dismissible fade show" style="border-radius:var(--radius-md);border:none;box-shadow:var(--shadow-sm);border-left:4px solid #dc3545;">
            <i class="fas fa-exclamation-circle me-2"></i><%= error_msg %>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
          </div>
        <% } %>
        <% if (typeof error !== 'undefined' && error.length > 0) { %>
          <div class="alert alert-danger alert-dismissible fade show" style="border-radius:var(--radius-md);border:none;box-shadow:var(--shadow-sm);border-left:4px solid #dc3545;">
            <i class="fas fa-exclamation-circle me-2"></i><%= error %>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
          </div>
        <% } %>
      </div>

      <!-- Page Content -->
      <div class="container-fluid p-4">
        <%- body %>
      </div>

      <!-- Admin Confirmation Modal -->
      <div class="modal fade" id="adminConfirmModal" tabindex="-1" aria-labelledby="adminConfirmModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
          <div class="modal-content">
            <div class="modal-header">
              <h5 class="modal-title" id="adminConfirmModalLabel"><i class="fas fa-question-circle text-warning me-2"></i>Confirm Action</h5>
              <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
              <span id="adminConfirmModalMessage">Are you sure you want to proceed?</span>
            </div>
            <div class="modal-footer">
              <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
              <button type="button" class="btn btn-danger" id="adminConfirmModalOk">Yes, Proceed</button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/main.js"></script>
</body>
</html>
