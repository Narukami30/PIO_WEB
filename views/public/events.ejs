<%- include('../partials/notificationBanner') %>
<section class="page-header text-white">
  <div class="container">
    <h1><i class="fas fa-calendar-alt me-2"></i>Events</h1>
    <nav aria-label="breadcrumb">
      <ol class="breadcrumb mb-0">
        <li class="breadcrumb-item"><a href="/">Home</a></li>
        <li class="breadcrumb-item active text-white">Events</li>
      </ol>
    </nav>
  </div>
</section>

<section class="py-5">
  <div class="container">
    <!-- Search Bar -->
    <div class="row justify-content-center mb-4 fade-up">
      <div class="col-lg-6 col-md-8">
        <form action="/events" method="GET" class="input-group" data-no-validate>
          <input type="text" class="form-control rounded-start-3" name="search" placeholder="Search events..." value="<%= typeof query !== 'undefined' && query.search ? query.search : '' %>">
          <button class="btn btn-primary rounded-end-3" type="submit"><i class="fas fa-search"></i></button>
          <% if (typeof query !== 'undefined' && query.search) { %>
            <a href="/events" class="btn btn-outline-secondary ms-2 rounded-3" title="Clear search"><i class="fas fa-times"></i></a>
          <% } %>
        </form>
      </div>
    </div>

    <% if (events.length === 0) { %>
      <div class="text-center py-5 fade-up">
        <div class="icon-wrapper mx-auto mb-3" style="width:80px;height:80px;font-size:2rem;">
          <i class="fas fa-calendar-times"></i>
        </div>
        <h4 class="fw-bold">No Upcoming Events</h4>
        <p class="text-muted">Check back soon for new events and activities.</p>
      </div>
    <% } else { %>
      <div class="row g-4">
        <% events.forEach(event => { %>
          <div class="col-6 col-md-6 col-lg-4 fade-up">
            <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden card-hover">
              <% if (event.image) { %>
                <img src="<%= event.image %>" class="card-img-top" alt="<%= event.title %>" style="height: 200px; object-fit: cover;">
              <% } else { %>
                <div class="card-img-top d-flex align-items-center justify-content-center" style="height: 200px; background: linear-gradient(135deg, var(--naujan-primary), var(--naujan-secondary));">
                  <i class="fas fa-calendar-day fa-3x text-white opacity-75"></i>
                </div>
              <% } %>
              <div class="card-body">
                <div class="d-flex justify-content-between align-items-start mb-2">
                  <span class="badge bg-soft-primary text-primary rounded-pill"><%= event.category.replace(/_/g, ' ') %></span>
                  <% if (event.isFeatured) { %>
                    <span class="badge bg-soft-warning text-warning rounded-pill"><i class="fas fa-star me-1"></i>Featured</span>
                  <% } %>
                </div>
                <h5 class="card-title fw-bold"><%= event.title %></h5>
                <p class="card-text text-muted small"><%= truncate(event.description, 120) %></p>
              </div>
              <div class="card-footer bg-transparent border-top-0 px-3 pb-3">
                <div class="small text-muted">
                  <div class="mb-1"><i class="fas fa-calendar me-2 text-primary"></i>
                    <%= formatDate(event.startDate, 'short') %>
                    <% if (event.endDate) { %> — <%= formatDate(event.endDate, 'short') %><% } %>
                  </div>
                  <% if (event.location) { %>
                    <div class="mb-1"><i class="fas fa-map-marker-alt me-2 text-danger"></i><%= event.location %></div>
                  <% } %>
                  <% if (event.department) { %>
                    <div><i class="fas fa-building me-2 text-muted"></i><%= event.department.name %></div>
                  <% } %>
                </div>
              </div>
            </div>
          </div>
        <% }) %>
      </div>

      <!-- Pagination -->
      <% if (totalPages > 1) { %>
        <nav class="mt-5 fade-up">
          <ul class="pagination justify-content-center">
            <li class="page-item page-nav <%= currentPage <= 1 ? 'disabled' : '' %>"><a class="page-link" href="?page=<%= currentPage - 1 %><%= typeof query !== 'undefined' && query.search ? '&search=' + encodeURIComponent(query.search) : '' %>"><i class="fas fa-chevron-left"></i><span class="page-nav-text ms-1">Prev</span></a></li>
            <% const delta = 2; for (let i = 1; i <= totalPages; i++) { if (i === 1 || i === totalPages || (i >= currentPage - delta && i <= currentPage + delta)) { %>
              <li class="page-item page-num <%= i === currentPage ? 'active' : '' %> <%= (i === 1 || i === totalPages) ? 'page-edge' : '' %>"><a class="page-link" href="?page=<%= i %><%= typeof query !== 'undefined' && query.search ? '&search=' + encodeURIComponent(query.search) : '' %>"><%= i %></a></li>
            <% } else if (i === currentPage - delta - 1 || i === currentPage + delta + 1) { %>
              <li class="page-item disabled"><span class="page-link">&hellip;</span></li>
            <% } } %>
            <li class="page-item page-nav <%= currentPage >= totalPages ? 'disabled' : '' %>"><a class="page-link" href="?page=<%= currentPage + 1 %><%= typeof query !== 'undefined' && query.search ? '&search=' + encodeURIComponent(query.search) : '' %>"><span class="page-nav-text me-1">Next</span><i class="fas fa-chevron-right"></i></a></li>
          </ul>
        </nav>
      <% } %>
    <% } %>
  </div>
</section>
