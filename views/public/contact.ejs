<%- include('../partials/notificationBanner') %>
<section class="page-header text-white">
  <div class="container">
    <h1><i class="fas fa-envelope me-2"></i>Contact Us</h1>
    <nav aria-label="breadcrumb">
      <ol class="breadcrumb mb-0">
        <li class="breadcrumb-item"><a href="/">Home</a></li>
        <li class="breadcrumb-item active text-white">Contact</li>
      </ol>
    </nav>
  </div>
</section>

<section class="py-5">
  <div class="container">
    <div class="row g-5">
      <div class="col-lg-6 fade-up">
        <span class="badge bg-soft-primary text-primary px-3 py-2 mb-3" style="border-radius:50px;">Get In Touch</span>
        <h3 class="fw-bold mb-4">New Naujan Municipal Hall</h3>
        
        <div class="d-flex mb-4">
          <div style="width:48px;height:48px;border-radius:12px;background:rgba(21,101,192,0.18);display:flex;align-items:center;justify-content:center;margin-right:16px;flex-shrink:0;">
            <i class="fas fa-map-marker-alt text-primary"></i>
          </div>
          <div>
            <strong style="font-size:0.9rem;">Address</strong>
            <p class="mb-0" style="color:var(--text-secondary);font-size:0.9rem;">Santiago, Naujan, Oriental Mindoro, Philippines</p>
          </div>
        </div>
        <div class="d-flex mb-4">
          <div style="width:48px;height:48px;border-radius:12px;background:rgba(25,135,84,0.18);display:flex;align-items:center;justify-content:center;margin-right:16px;flex-shrink:0;">
            <i class="fas fa-phone text-success"></i>
          </div>
          <div>
            <strong style="font-size:0.9rem;">Phone</strong>
            <p class="mb-0" style="color:var(--text-secondary);font-size:0.9rem;">0912 684 2097</p>
          </div>
        </div>
        <div class="d-flex mb-4">
          <div style="width:48px;height:48px;border-radius:12px;background:rgba(66,165,245,0.18);display:flex;align-items:center;justify-content:center;margin-right:16px;flex-shrink:0;">
            <i class="fas fa-envelope text-info"></i>
          </div>
          <div>
            <strong style="font-size:0.9rem;">Email</strong>
            <p class="mb-0" style="color:var(--text-secondary);font-size:0.9rem;">publicinformationoffice02@gmail.com</p>
          </div>
        </div>
        <div class="d-flex mb-4">
          <div style="width:48px;height:48px;border-radius:12px;background:rgba(240,165,0,0.18);display:flex;align-items:center;justify-content:center;margin-right:16px;flex-shrink:0;">
            <i class="fas fa-clock text-warning"></i>
          </div>
          <div>
            <strong style="font-size:0.9rem;">Office Hours</strong>
            <p class="mb-0" style="color:var(--text-secondary);font-size:0.9rem;">Monday - Friday, 8:00 AM - 5:00 PM</p>
          </div>
        </div>

        <h6 class="mt-4 mb-2 fw-bold" style="font-size:0.85rem;text-transform:uppercase;letter-spacing:1.5px;color:var(--text-secondary);">Follow Us</h6>
        <div class="d-flex gap-3 mt-3">
          <a href="https://www.facebook.com/share/1DJyZqUqbk/" target="_blank" rel="noopener" class="social-icon" style="background:rgba(21,101,192,0.2);color:#42a5f5;border:1px solid rgba(21,101,192,0.35);" aria-label="PIO Facebook" title="Facebook">
            <i class="fab fa-facebook-f"></i>
          </a>
          <a href="https://www.youtube.com/@NaujanPIO" target="_blank" rel="noopener" class="social-icon" style="background:rgba(220,53,69,0.2);color:#f87171;border:1px solid rgba(220,53,69,0.35);" aria-label="PIO YouTube" title="YouTube">
            <i class="fab fa-youtube"></i>
          </a>
          <a href="mailto:publicinformationoffice02@gmail.com" class="social-icon" style="background:rgba(66,165,245,0.2);color:#42a5f5;border:1px solid rgba(66,165,245,0.35);" aria-label="PIO Email" title="Email">
            <i class="fas fa-envelope"></i>
          </a>
        </div>
      </div>
      <div class="col-lg-6 fade-up">
        <div class="card border-0 shadow-sm" style="border-radius:var(--radius-lg);overflow:hidden;">
          <div class="card-body p-4">
            <h5 class="fw-bold mb-1"><i class="fas fa-paper-plane me-2 text-primary"></i>Send us a Message</h5>
            <p style="color:var(--text-muted);font-size:0.85rem;" class="mb-4">For general inquiries. For complaints, use the <a href="/complaint">complaint form</a>.</p>
            <form action="/feedback" method="POST">
              <input type="hidden" name="category" value="inquiry">
              <div class="mb-3">
                <label class="form-label">Full Name *</label>
                <input type="text" class="form-control" name="citizenName" required placeholder="Enter your full name">
              </div>
              <div class="mb-3">
                <label class="form-label">Email</label>
                <input type="email" class="form-control" name="email" placeholder="your@email.com">
              </div>
              <div class="mb-3">
                <label class="form-label">Subject *</label>
                <input type="text" class="form-control" name="subject" required placeholder="What is this about?">
              </div>
              <div class="mb-3">
                <label class="form-label">Message *</label>
                <textarea class="form-control" name="message" rows="4" required placeholder="Type your message here..."></textarea>
              </div>
              <button type="submit" class="btn btn-primary w-100" style="border-radius:50px;padding:0.7rem;"><i class="fas fa-paper-plane me-2"></i>Send Message</button>
            </form>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>