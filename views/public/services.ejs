<%- include('../partials/notificationBanner') %>
<section class="page-header text-white">
  <div class="container">
    <h1><i class="fas fa-concierge-bell me-2"></i>Citizen's Charter</h1>
    <nav aria-label="breadcrumb">
      <ol class="breadcrumb mb-0">
        <li class="breadcrumb-item"><a href="/">Home</a></li>
        <li class="breadcrumb-item active text-white">Services</li>
      </ol>
    </nav>
  </div>
</section>


<section class="py-5">
  <div class="container">
    <% if (services.length > 0 || (typeof query !== 'undefined' && query.search)) { %>
      <div class="text-center mb-4 fade-up">
        <span class="badge bg-soft-primary text-primary rounded-pill px-3 py-2 mb-2">Government Services</span>
        <h3 class="fw-bold">What We Can Help You With</h3>
        <p style="color:var(--text-muted);">Browse through our citizen's charter for service requirements and procedures</p>
      </div>
      <!-- Search Bar -->
      <div class="row justify-content-center mb-4 fade-up">
        <div class="col-lg-6 col-md-8">
          <form action="/services" method="GET" class="input-group" data-no-validate>
            <input type="text" class="form-control rounded-start-3" name="search" placeholder="Search services..." value="<%= typeof query !== 'undefined' && query.search ? query.search : '' %>">
            <button class="btn btn-primary rounded-end-3" type="submit"><i class="fas fa-search"></i></button>
            <% if (typeof query !== 'undefined' && query.search) { %>
              <a href="/services" class="btn btn-outline-secondary ms-2 rounded-3" title="Clear search"><i class="fas fa-times"></i></a>
            <% } %>
          </form>
        </div>
      </div>
    <% } %>
    <% if (services.length > 0) { %>
      <div class="accordion" id="servicesAccordion">
        <% services.forEach((service, index) => { %>
          <div class="accordion-item border-0 shadow-sm mb-3 rounded-3 overflow-hidden fade-up">
            <h2 class="accordion-header">
              <button class="accordion-button <%= index > 0 ? 'collapsed' : '' %> fw-semibold" type="button" data-bs-toggle="collapse" data-bs-target="#service-<%= index %>">
                <span class="icon-wrapper me-3" style="width:40px;height:40px;font-size:1rem;">
                  <i class="fas fa-concierge-bell"></i>
                </span>
                <div>
                  <strong><%= service.name %></strong>
                  <% if (service.department) { %>
                    <small style="color:var(--text-muted);" class="d-block"><i class="fas fa-building me-1"></i><%= service.department.name %></small>
                  <% } %>
                </div>
              </button>
            </h2>
            <div id="service-<%= index %>" class="accordion-collapse collapse <%= index === 0 ? 'show' : '' %>" data-bs-parent="#servicesAccordion">
              <div class="accordion-body" style="background:rgba(255,255,255,0.02);">
                <p><%= service.description %></p>

                <% if (service.requirements && service.requirements.length > 0) { %>
                  <div class="rounded-3 p-3 mb-3" style="background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.06);">
                    <h6 class="text-primary"><i class="fas fa-clipboard-list me-2"></i>Requirements:</h6>
                    <ul class="mb-0">
                      <% service.requirements.forEach(req => { %>
                        <li><%= req %></li>
                      <% }) %>
                    </ul>
                  </div>
                <% } %>

                <% if (service.steps && service.steps.length > 0) { %>
                  <div class="rounded-3 p-3 mb-3" style="background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.06);">
                    <h6 class="text-primary"><i class="fas fa-list-ol me-2"></i>Steps:</h6>
                    <ol class="mb-0">
                      <% service.steps.forEach(step => { %>
                        <li class="mb-1"><%= step.description %></li>
                      <% }) %>
                    </ol>
                  </div>
                <% } %>

                <div class="row mt-3">
                  <% if (service.fees) { %>
                    <div class="col-md-4">
                      <div class="d-flex align-items-center">
                        <span class="icon-wrapper me-2" style="width:32px;height:32px;font-size:0.8rem;background:var(--naujan-gold);color:#fff;">
                          <i class="fas fa-money-bill"></i>
                        </span>
                        <div><small style="color:var(--text-muted);" class="d-block">Fees</small><strong><%= service.fees %></strong></div>
                      </div>
                    </div>
                  <% } %>
                  <% if (service.processingTime) { %>
                    <div class="col-md-4">
                      <div class="d-flex align-items-center">
                        <span class="icon-wrapper me-2" style="width:32px;height:32px;font-size:0.8rem;background:var(--naujan-secondary);color:#fff;">
                          <i class="fas fa-clock"></i>
                        </span>
                        <div><small style="color:var(--text-muted);" class="d-block">Processing Time</small><strong><%= service.processingTime %></strong></div>
                      </div>
                    </div>
                  <% } %>
                </div>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
    <% } else { %>
      <div class="text-center py-5 text-muted fade-up">
        <div class="icon-wrapper mx-auto mb-3" style="width:80px;height:80px;font-size:2rem;">
          <i class="fas fa-concierge-bell"></i>
        </div>
        <h5>No services listed yet</h5>
        <p class="text-muted">Check back soon for updates.</p>
      </div>
    <% } %>
  </div>
</section>
