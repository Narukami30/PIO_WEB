<%- include('../partials/notificationBanner') %>
<section class="page-header text-white">
  <div class="container">
    <h1><i class="fas fa-users me-2"></i>Officials & Departments</h1>
    <nav aria-label="breadcrumb">
      <ol class="breadcrumb mb-0">
        <li class="breadcrumb-item"><a href="/">Home</a></li>
        <li class="breadcrumb-item active text-white">Officials</li>
      </ol>
    </nav>
  </div>
</section>

<section class="py-5">
  <div class="container">
    <div class="text-center mb-5 fade-up">
      <span class="badge bg-soft-primary text-primary rounded-pill px-3 py-2 mb-2">Our Team</span>
      <h3 class="fw-bold">Municipal Officials & Departments</h3>
      <p class="text-muted">Dedicated public servants working for Naujan</p>
    </div>
    <div class="row g-4">
      <% if (departments.length > 0) { %>
        <% departments.forEach(dept => { %>
          <div class="col-6 col-md-4 col-lg-3 fade-up">
            <div class="card h-100 border-0 text-center overflow-hidden official-card">
              <!-- Accent header bar -->
              <div class="official-card-accent"></div>
              <div class="card-body d-flex flex-column align-items-center px-3 pt-0 pb-3" style="margin-top:-50px;">
                <% if (dept.image) { %>
                  <img src="<%= dept.image %>" class="official-card-photo" alt="<%= dept.head %>">
                <% } else { %>
                  <div class="official-card-avatar">
                    <i class="fas fa-user-tie"></i>
                  </div>
                <% } %>
                <% if (dept.head) { %>
                  <h6 class="fw-bold mb-0 mt-2" style="color:var(--text-primary);line-height:1.3;"><%= dept.head %></h6>
                  <% if (dept.headTitle) { %>
                    <span class="official-card-title"><%= dept.headTitle %></span>
                  <% } %>
                <% } %>
                <span class="badge official-card-dept-badge mt-2"><%= dept.name %></span>
                <% if (dept.description) { %>
                  <p class="text-muted small mt-2 mb-0" style="line-height:1.5;font-size:0.78rem;text-align:justify;"><%= dept.description %></p>
                <% } %>
              </div>
              <% if (dept.phone || dept.email) { %>
              <div class="card-footer official-card-footer">
                <% if (dept.phone) { %><a href="tel:<%= dept.phone %>" class="official-contact-link"><i class="fas fa-phone-alt"></i> <%= dept.phone %></a><% } %>
                <% if (dept.email) { %><a href="mailto:<%= dept.email %>" class="official-contact-link"><i class="fas fa-envelope"></i> <%= dept.email %></a><% } %>
              </div>
              <% } %>
            </div>
          </div>
        <% }) %>
      <% } else { %>
        <div class="col-12 text-center py-5 text-muted fade-up">
          <div class="official-card-avatar mx-auto mb-3" style="width:90px;height:90px;font-size:2rem;">
            <i class="fas fa-users"></i>
          </div>
          <h5>No departments listed yet</h5>
          <p class="text-muted">Check back soon for updates.</p>
        </div>
      <% } %>
    </div>
  </div>
</section>
