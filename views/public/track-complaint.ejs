<%- include('../partials/notificationBanner') %>
<section class="page-header text-white">
  <div class="container">
    <h1><i class="fas fa-search me-2"></i>Track Your Complaint</h1>
    <nav aria-label="breadcrumb">
      <ol class="breadcrumb mb-0">
        <li class="breadcrumb-item"><a href="/">Home</a></li>
        <li class="breadcrumb-item active text-white">Track Complaint</li>
      </ol>
    </nav>
  </div>
</section>

<section class="py-5">
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-md-8">
        <!-- Search Form -->
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4 fade-up">
          <div class="card-body p-4">
            <form action="/track-complaint" method="POST">
              <div class="input-group input-group-lg">
                <span class="input-group-text bg-transparent border-end-0 rounded-start-pill"><i class="fas fa-search text-primary"></i></span>
                <input type="text" class="form-control border-start-0" name="trackingCode" 
                  placeholder="Enter Tracking Code (e.g., NJN-20240101-A1B2C3)"
                  value="<%= typeof trackingCode !== 'undefined' ? trackingCode : '' %>" required>
                <button type="submit" class="btn btn-primary rounded-end-pill px-4">Track</button>
              </div>
            </form>
          </div>
        </div>

        <% if (searched) { %>
          <% if (complaint) { %>
            <div class="card shadow-sm">
              <div class="card-header bg-primary text-white">
                <div class="d-flex justify-content-between align-items-center">
                  <h5 class="mb-0"><i class="fas fa-file-alt me-2"></i><%= complaint.trackingCode %></h5>
                  <span class="badge bg-<%= statusBadgeClass(complaint.status) %> fs-6"><%= complaint.status.replace(/_/g, ' ').toUpperCase() %></span>
                </div>
              </div>
              <div class="card-body">
                <div class="row g-3 mb-3">
                  <div class="col-12 col-md-6">
                    <strong>Subject:</strong> <%= complaint.subject %>
                  </div>
                  <div class="col-6 col-md-3">
                    <strong>Category:</strong> <span class="badge bg-secondary"><%= complaint.category.replace(/_/g, ' ') %></span>
                  </div>
                  <div class="col-6 col-md-3">
                    <strong>Priority:</strong> <span class="badge bg-<%= complaint.priority === 'urgent' ? 'danger' : complaint.priority === 'high' ? 'warning' : 'info' %>"><%= complaint.priority %></span>
                  </div>
                </div>

                <p><strong>Description:</strong></p>
                <p class="p-3 rounded" style="background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.06);"><%= complaint.description %></p>

                <div class="row mb-3 text-muted small">
                  <div class="col-md-4">
                    <i class="fas fa-calendar me-1"></i> Filed: <%= formatDate(complaint.createdAt, 'short') %>
                  </div>
                  <% if (complaint.department) { %>
                    <div class="col-md-4">
                      <i class="fas fa-building me-1"></i> <%= complaint.department.name %>
                    </div>
                  <% } %>
                  <% if (complaint.resolvedAt) { %>
                    <div class="col-md-4">
                      <i class="fas fa-check me-1"></i> Resolved: <%= formatDate(complaint.resolvedAt, 'short') %>
                    </div>
                  <% } %>
                </div>

                <% if (complaint.updates && complaint.updates.length > 0) { %>
                  <h6 class="mt-4"><i class="fas fa-history me-2"></i>Update History</h6>
                  <div class="timeline">
                    <% complaint.updates.forEach(upd => { %>
                      <div class="timeline-item mb-3 p-3 rounded" style="background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.06);">
                        <div class="d-flex justify-content-between">
                          <span class="badge bg-<%= statusBadgeClass(upd.status) %>"><%= upd.status.replace(/_/g, ' ') %></span>
                          <small class="text-muted"><%= formatDate(upd.updatedAt, 'short') %></small>
                        </div>
                        <p class="mb-0 mt-2"><%= upd.message %></p>
                        <% if (upd.updatedBy) { %>
                          <small class="text-muted">By: <%= upd.updatedBy.firstName %> <%= upd.updatedBy.lastName %></small>
                        <% } %>
                      </div>
                    <% }) %>
                  </div>
                <% } %>
              </div>
            </div>
          <% } else { %>
            <div class="alert alert-warning text-center">
              <i class="fas fa-exclamation-triangle me-2"></i>
              No complaint found with tracking code "<strong><%= trackingCode %></strong>". Please check and try again.
            </div>
          <% } %>
        <% } %>
      </div>
    </div>
  </div>
</section>
