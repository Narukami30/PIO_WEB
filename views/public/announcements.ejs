<%- include('../partials/notificationBanner') %>
<section class="page-header text-white">
  <div class="container">
    <h1><i class="fas fa-bullhorn me-2"></i>Announcements</h1>
    <nav aria-label="breadcrumb">
      <ol class="breadcrumb mb-0">
        <li class="breadcrumb-item"><a href="/">Home</a></li>
        <li class="breadcrumb-item active text-white">Announcements</li>
      </ol>
    </nav>
  </div>
</section>

<section class="py-5">
  <div class="container">
    <!-- Category Filter -->
    <div class="mb-4 fade-up">
      <div class="d-flex flex-wrap gap-2 category-filter-pills" role="group">
        <a href="/announcements" class="btn btn-sm <%= !query.category ? 'btn-primary' : 'btn-outline-primary' %>" style="border-radius:50px;padding:0.4rem 1rem;">All</a>
        <a href="/announcements?category=general" class="btn btn-sm <%= query.category === 'general' ? 'btn-primary' : 'btn-outline-primary' %>" style="border-radius:50px;padding:0.4rem 1rem;">General</a>
        <a href="/announcements?category=notice" class="btn btn-sm <%= query.category === 'notice' ? 'btn-primary' : 'btn-outline-primary' %>" style="border-radius:50px;padding:0.4rem 1rem;">Notice</a>
        <a href="/announcements?category=advisory" class="btn btn-sm <%= query.category === 'advisory' ? 'btn-primary' : 'btn-outline-primary' %>" style="border-radius:50px;padding:0.4rem 1rem;">Advisory</a>
        <a href="/announcements?category=ordinance" class="btn btn-sm <%= query.category === 'ordinance' ? 'btn-primary' : 'btn-outline-primary' %>" style="border-radius:50px;padding:0.4rem 1rem;">Ordinance</a>
        <a href="/announcements?category=procurement" class="btn btn-sm <%= query.category === 'procurement' ? 'btn-primary' : 'btn-outline-primary' %>" style="border-radius:50px;padding:0.4rem 1rem;">Procurement</a>
        <a href="/announcements?category=jobs" class="btn btn-sm <%= query.category === 'jobs' ? 'btn-primary' : 'btn-outline-primary' %>" style="border-radius:50px;padding:0.4rem 1rem;">Jobs</a>
      </div>
    </div>

    <div class="row g-4">
      <% if (announcements.length > 0) { %>
        <% announcements.forEach(item => { %>
          <div class="col-sm-6 col-md-4 fade-up">
            <div class="card h-100 card-hover border-0 shadow-sm" style="overflow:hidden;">
              <div style="overflow:hidden;">
                <% if (item.image) { %>
                  <img src="<%= item.image %>" class="card-img-top" alt="<%= item.title %>" style="height: 210px; object-fit: cover;">
                <% } else { %>
                  <div class="card-img-top d-flex align-items-center justify-content-center" style="height: 210px; background: linear-gradient(135deg, #0f4c75, #3282b8);">
                    <i class="fas fa-newspaper fa-3x text-white" style="opacity:0.4;"></i>
                  </div>
                <% } %>
              </div>
              <div class="card-body">
                <div class="d-flex gap-2 mb-2">
                  <span class="badge bg-primary"><%= item.category %></span>
                  <% if (item.isPinned) { %><span class="badge bg-warning text-dark"><i class="fas fa-thumbtack"></i> Pinned</span><% } %>
                </div>
                <h5 class="card-title" style="font-size:1.05rem;line-height:1.4;"><%= item.title %></h5>
                <p class="card-text small" style="color:var(--text-muted);"><%= truncate(item.excerpt || item.content, 100) %></p>
              </div>
              <div class="card-footer bg-transparent d-flex justify-content-between align-items-center">
                <small style="color:var(--text-muted);"><i class="far fa-clock me-1"></i><%= formatDate(item.publishedAt || item.createdAt, 'short') %></small>
                <a href="/announcements/<%= item.slug %>" class="btn btn-sm btn-primary" style="border-radius:50px;padding:0.3rem 1rem;">Read <i class="fas fa-arrow-right ms-1" style="font-size:0.7rem;"></i></a>
              </div>
            </div>
          </div>
        <% }) %>
      <% } else { %>
        <div class="col-12 text-center py-5" style="color:var(--text-muted);">
          <i class="fas fa-newspaper fa-3x mb-3" style="opacity:0.3;"></i>
          <p>No announcements found.</p>
        </div>
      <% } %>
    </div>

    <!-- Pagination -->
    <% if (pages > 1) { %>
      <% const qp = query.category ? '&category=' + query.category : ''; %>
      <nav class="mt-5">
        <ul class="pagination justify-content-center">
          <li class="page-item page-nav <%= current === 1 ? 'disabled' : '' %>"><a class="page-link" href="/announcements?page=<%= current - 1 %><%= qp %>"><i class="fas fa-chevron-left"></i><span class="page-nav-text ms-1">Prev</span></a></li>
          <% const delta = 2; for (let i = 1; i <= pages; i++) { if (i === 1 || i === pages || (i >= current - delta && i <= current + delta)) { %>
            <li class="page-item page-num <%= current === i ? 'active' : '' %> <%= (i === 1 || i === pages) ? 'page-edge' : '' %>"><a class="page-link" href="/announcements?page=<%= i %><%= qp %>"><%= i %></a></li>
          <% } else if (i === current - delta - 1 || i === current + delta + 1) { %>
            <li class="page-item disabled"><span class="page-link">&hellip;</span></li>
          <% } } %>
          <li class="page-item page-nav <%= current === pages ? 'disabled' : '' %>"><a class="page-link" href="/announcements?page=<%= current + 1 %><%= qp %>"><span class="page-nav-text me-1">Next</span><i class="fas fa-chevron-right"></i></a></li>
        </ul>
      </nav>
    <% } %>
  </div>
</section>
