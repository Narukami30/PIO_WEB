<div class="admin-sidebar" id="adminSidebar">
  <div class="sidebar-header">
    <a href="/admin/dashboard" class="text-white text-decoration-none d-flex align-items-center gap-3">
      <div style="width:44px;height:44px;background:linear-gradient(135deg,rgba(240,165,0,0.25),rgba(50,130,184,0.15));border-radius:14px;display:flex;align-items:center;justify-content:center;flex-shrink:0;border:1px solid rgba(240,165,0,0.15);">
        <i class="fas fa-landmark" style="font-size:1.1rem;color:var(--naujan-gold);"></i>
      </div>
      <div>
        <strong style="font-size:0.95rem;letter-spacing:0.3px;">Public Information Office</strong>
        <small class="d-block" style="color:rgba(255,255,255,0.3);font-size:0.6rem;letter-spacing:2px;text-transform:uppercase;font-weight:700;">Super Admin</small>
      </div>
    </a>
  </div>

  <nav class="sidebar-nav py-3">
    <ul class="nav flex-column">
      <li class="nav-item">
        <a class="nav-link <%= currentPath === '/admin/dashboard' ? 'active' : '' %>" href="/admin/dashboard">
          <i class="fas fa-th-large me-2"></i> Dashboard
        </a>
      </li>

      <li class="nav-item mt-2">
        <small class="sidebar-heading">Content Management</small>
      </li>
      <li class="nav-item">
        <a class="nav-link <%= currentPath.includes('/admin/announcements') ? 'active' : '' %>" href="/admin/announcements">
          <i class="fas fa-bullhorn me-2"></i> Announcements
        </a>
      </li>
      <li class="nav-item">
        <a class="nav-link <%= currentPath.includes('/admin/events') ? 'active' : '' %>" href="/admin/events">
          <i class="fas fa-calendar-alt me-2"></i> Events
        </a>
      </li>
      <li class="nav-item">
        <a class="nav-link <%= currentPath.includes('/admin/documents') ? 'active' : '' %>" href="/admin/documents">
          <i class="fas fa-file-alt me-2"></i> Documents
        </a>
      </li>
      <li class="nav-item">
        <a class="nav-link <%= currentPath.includes('/admin/transparency') ? 'active' : '' %>" href="/admin/transparency">
          <i class="fas fa-eye me-2"></i> Transparency
        </a>
      </li>
      <li class="nav-item">
        <a class="nav-link <%= currentPath.includes('/admin/services') ? 'active' : '' %>" href="/admin/services">
          <i class="fas fa-concierge-bell me-2"></i> Services
        </a>
      </li>

      <li class="nav-item mt-2">
        <small class="sidebar-heading">Emergency</small>
      </li>
      <li class="nav-item">
        <a class="nav-link <%= currentPath.includes('/admin/disaster') ? 'active' : '' %>" href="/admin/disaster">
          <i class="fas fa-exclamation-triangle me-2" style="color:rgba(240,165,0,0.7);"></i> DRRM Updates
        </a>
      </li>

      <li class="nav-item mt-2">
        <small class="sidebar-heading">Citizen Engagement</small>
      </li>
      <li class="nav-item">
        <a class="nav-link <%= currentPath.includes('/admin/feedback') ? 'active' : '' %>" href="/admin/feedback">
          <i class="fas fa-comment-dots me-2"></i> Feedback
        </a>
      </li>
      <li class="nav-item">
        <a class="nav-link <%= currentPath.includes('/admin/complaints') ? 'active' : '' %>" href="/admin/complaints">
          <i class="fas fa-flag me-2"></i> Complaints
        </a>
      </li>

      <% if (user && user.role && (user.role.name === 'super_admin' || user.role.name === 'ict_officer')) { %>
      <li class="nav-item mt-2">
        <small class="sidebar-heading">Administration</small>
      </li>
      <li class="nav-item">
        <a class="nav-link <%= currentPath.includes('/admin/departments') ? 'active' : '' %>" href="/admin/departments">
          <i class="fas fa-building me-2"></i> Departments
        </a>
      </li>
      <li class="nav-item">
        <a class="nav-link <%= currentPath.includes('/admin/users') ? 'active' : '' %>" href="/admin/users">
          <i class="fas fa-users-cog me-2"></i> Users
        </a>
      </li>
      <li class="nav-item">
        <a class="nav-link <%= currentPath.includes('/admin/audit') ? 'active' : '' %>" href="/admin/audit-logs">
          <i class="fas fa-history me-2"></i> Audit Logs
        </a>
      </li>
      <li class="nav-item">
        <a class="nav-link <%= currentPath.includes('/admin/settings') ? 'active' : '' %>" href="/admin/settings">
          <i class="fas fa-cogs me-2"></i> Site Settings
        </a>
      </li>
      <% } %>

      <li class="nav-item mt-3 pt-3" style="border-top:1px solid rgba(255,255,255,0.04);">
        <a class="nav-link" href="/" target="_blank" style="color:rgba(255,255,255,0.35);">
          <i class="fas fa-external-link-alt me-2"></i> View Website
        </a>
      </li>
    </ul>
  </nav>

  <!-- Sidebar user info -->
  <div class="sidebar-user-info">
    <div class="d-flex align-items-center gap-2">
      <div style="width:34px;height:34px;border-radius:10px;background:linear-gradient(135deg,var(--naujan-primary),var(--naujan-secondary));display:flex;align-items:center;justify-content:center;flex-shrink:0;">
        <i class="fas fa-user text-white" style="font-size:0.65rem;"></i>
      </div>
      <div style="overflow:hidden;">
        <% if (user) { %>
          <div style="font-size:0.78rem;font-weight:600;color:rgba(255,255,255,0.8);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;"><%= user.firstName %> <%= user.lastName %></div>
          <div style="font-size:0.62rem;color:rgba(240,165,0,0.6);font-weight:600;letter-spacing:0.5px;"><%= user.role ? user.role.displayName : '' %></div>
        <% } %>
      </div>
    </div>
  </div>
</div>
