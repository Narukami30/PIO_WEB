<form action="/auth/reset-password/<%= token %>" method="POST" novalidate>
  <div class="text-center mb-4">
    <h5 style="font-weight:800;color:#1a2332;margin-bottom:0.25rem;">Reset Password</h5>
    <p style="font-size:0.8rem;color:#888;margin:0;">Enter your new password below</p>
  </div>
  <div class="mb-3">
    <label class="form-label">New Password</label>
    <div class="password-toggle-wrap input-icon-wrap">
      <i class="fas fa-lock input-icon"></i>
      <input type="password" name="password" class="form-control" required minlength="8" placeholder="Min 8 characters" style="padding-left:2.6rem;padding-right:2.75rem;">
      <button type="button" class="password-toggle-btn" tabindex="-1" aria-label="Toggle password visibility">
        <i class="fas fa-eye"></i>
      </button>
    </div>
    <div class="form-text" style="font-size:0.72rem;color:#999;">Must include uppercase, lowercase, number, and special character.</div>
  </div>
  <div class="mb-4">
    <label class="form-label">Confirm Password</label>
    <div class="password-toggle-wrap input-icon-wrap">
      <i class="fas fa-lock input-icon"></i>
      <input type="password" name="password2" class="form-control" required minlength="8" placeholder="Re-enter password" style="padding-left:2.6rem;padding-right:2.75rem;">
      <button type="button" class="password-toggle-btn" tabindex="-1" aria-label="Toggle password visibility">
        <i class="fas fa-eye"></i>
      </button>
    </div>
  </div>
  <button type="submit" class="btn btn-primary w-100 btn-ripple"><i class="fas fa-key me-2"></i>Reset Password</button>
</form>
<div class="text-center mt-3">
  <a href="/auth/login" style="font-size:0.8rem;font-weight:600;"><i class="fas fa-arrow-left me-1"></i>Back to Sign In</a>
</div>
