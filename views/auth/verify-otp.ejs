<form action="/auth/verify-otp" method="POST">
  <div class="text-center mb-4">
    <h5 style="font-weight:800;color:#1a2332;margin-bottom:0.25rem;">Two-Factor Verification</h5>
    <p style="font-size:0.8rem;color:#888;margin:0;">Enter the 6-digit code sent to your email</p>
  </div>
  <div class="mb-4">
    <label class="form-label">Verification Code</label>
    <div class="input-icon-wrap">
      <i class="fas fa-shield-alt input-icon"></i>
      <input
        type="text"
        name="otp"
        class="form-control text-center"
        required
        autofocus
        maxlength="6"
        pattern="[0-9]{6}"
        inputmode="numeric"
        placeholder="000000"
        autocomplete="one-time-code"
        style="font-size:1.4rem;font-weight:700;letter-spacing:0.5rem;padding-left:2.6rem;">
    </div>
    <div class="form-text" style="color:rgba(255,255,255,0.4);font-size:0.75rem;margin-top:0.4rem;">
      <i class="fas fa-clock me-1"></i>Code expires in 10 minutes
    </div>
  </div>
  <button type="submit" class="btn btn-primary w-100 btn-ripple mb-3">
    <i class="fas fa-check-circle me-2"></i>Verify Code
  </button>
  <div class="text-center">
    <a href="/auth/login" style="font-size:0.82rem;color:rgba(255,255,255,0.45);">
      <i class="fas fa-arrow-left me-1"></i>Back to Login
    </a>
  </div>
</form>
