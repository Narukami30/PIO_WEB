<form action="/auth/login" method="POST">
  <div class="text-center mb-4">
    <h5 style="font-weight:800;color:#1a2332;margin-bottom:0.25rem;">Welcome Back</h5>
    <p style="font-size:0.8rem;color:#888;margin:0;">Sign in to your admin account</p>
  </div>
  <div class="mb-3">
    <label class="form-label">Email Address</label>
    <div class="input-icon-wrap">
      <i class="fas fa-envelope input-icon"></i>
      <input type="email" name="email" class="form-control" required autofocus placeholder="Enter email">
    </div>
  </div>
  <div class="mb-4">
    <div class="d-flex justify-content-between align-items-center">
      <label class="form-label">Password</label>
      <a href="/auth/forgot-password" style="font-size:0.75rem;font-weight:600;color:#0f4c75;">Forgot Password?</a>
    </div>
    <div class="password-toggle-wrap input-icon-wrap">
      <i class="fas fa-lock input-icon"></i>
      <input type="password" name="password" class="form-control" required placeholder="Enter password" style="padding-left:2.6rem;padding-right:2.75rem;">
      <button type="button" class="password-toggle-btn" tabindex="-1" aria-label="Toggle password visibility">
        <i class="fas fa-eye"></i>
      </button>
    </div>
  </div>
  <button type="submit" class="btn btn-primary w-100 btn-ripple"><i class="fas fa-sign-in-alt me-2"></i>Sign In</button>
</form>
